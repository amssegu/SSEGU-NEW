---
import '../styles/global.css';
import SeoHead from '../components/shared/SeoHead.astro';
import CookieConsent from '../components/shared/CookieConsent.astro';
import type { JsonLd } from '../lib/seo';
import { adsenseClient } from '../lib/adsense';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  section?: string;
  structuredData?: JsonLd;
}

const {
  title = 'SSEGU | Inform. Educate. Empower.',
  description = 'SSEGU brings useful, timely stories from Uganda and beyond.',
  canonical,
  noindex = false,
  image,
  type = 'website',
  publishedAt,
  updatedAt,
  author,
  section,
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      image={image}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      author={author}
      section={section}
      structuredData={structuredData}
    />
    {adsenseClient && <link rel="preconnect" href="https://pagead2.googlesyndication.com" />}
    {adsenseClient && <link rel="preconnect" href="https://googleads.g.doubleclick.net" />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <CookieConsent adsenseClient={adsenseClient} />
    <slot />
    <script is:inline>
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          document
            .querySelectorAll('[data-menu][open]')
            .forEach((menu) => menu.removeAttribute('open'));
        }
      });
    </script>
    <script is:inline>
      const cookieConsentKey = 'ssegu-ad-consent';
      const cookieConsentDuration = 7 * 24 * 60 * 60 * 1000;
      const cookieConsent = document.querySelector('[data-cookie-consent]');
      const adsenseClient = cookieConsent?.dataset.adsenseClient;
      const adsAllowedHost = ['ssegu.com', 'www.ssegu.com'].includes(window.location.hostname);
      if (!adsAllowedHost) {
        cookieConsent?.setAttribute('hidden', '');
        document.querySelectorAll('.ad-unit').forEach((ad) => ad.setAttribute('hidden', ''));
      }
      const readConsent = () => {
        const value = document.cookie
          .split('; ')
          .find((entry) => entry.startsWith(`${cookieConsentKey}=`))
          ?.split('=')[1];
        if (!value) return null;
        try {
          const consent = JSON.parse(decodeURIComponent(value));
          return consent.expires > Date.now() ? consent : null;
        } catch {
          return null;
        }
      };
      const saveConsent = (allowed) => {
        const value = encodeURIComponent(
          JSON.stringify({ allowed, expires: Date.now() + cookieConsentDuration }),
        );
        document.cookie = `${cookieConsentKey}=${value}; max-age=${cookieConsentDuration / 1000}; path=/; samesite=lax`;
      };
      const requestAds = () => {
        if (
          !adsAllowedHost ||
          !adsenseClient ||
          document.querySelector('script[data-ssegu-adsense]')
        )
          return;
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`;
        script.crossOrigin = 'anonymous';
        script.dataset.sseguAdsense = 'true';
        script.onload = () => {
          document.querySelectorAll('.adsbygoogle:not([data-ad-requested])').forEach((ad) => {
            ad.setAttribute('data-ad-requested', '1');
            try {
              (window.adsbygoogle = window.adsbygoogle || []).push({});
            } catch (error) {
              ad.removeAttribute('data-ad-requested');
              console.warn('AdSense could not load this ad slot.', error);
            }
          });
        };
        document.head.appendChild(script);
      };
      const consent = readConsent();
      if (adsAllowedHost && consent?.allowed) requestAds();
      if (adsAllowedHost && !consent && cookieConsent) cookieConsent.hidden = false;
      cookieConsent?.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
        saveConsent(true);
        cookieConsent.hidden = true;
        requestAds();
      });
      cookieConsent?.querySelector('[data-cookie-decline]')?.addEventListener('click', () => {
        saveConsent(false);
        cookieConsent.hidden = true;
      });
    </script>
  </body>
</html>
