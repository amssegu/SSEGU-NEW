---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'SSEGU', description = 'SSEGU main publication fixture foundation.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <slot />
  </body>
</html>
