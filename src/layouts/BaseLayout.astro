---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = 'SSEGU | Inform. Educate. Empower.',
  description = 'SSEGU brings useful, timely stories from Uganda and beyond.',
  canonical,
  noindex = false,
} = Astro.props;
const adsenseEnabled = import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true';
const adsenseClient = adsenseEnabled ? import.meta.env.PUBLIC_ADSENSE_CLIENT : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#2b0b57" />
    {Astro.url.pathname.startsWith('/tv') && (
      <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous" />
    )}
    {adsenseClient && (
      <>
        <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
        <link rel="preconnect" href="https://googleads.g.doubleclick.net" />
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        ></script>
      </>
    )}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <slot />
    <script is:inline>
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          document
            .querySelectorAll('[data-menu][open]')
            .forEach((menu) => menu.removeAttribute('open'));
        }
      });
    </script>
    {adsenseClient && <script is:inline>
      document.querySelectorAll('.adsbygoogle:not([data-ad-requested])').forEach((ad) => {
        ad.setAttribute('data-ad-requested', '1');
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (error) {
          ad.removeAttribute('data-ad-requested');
          console.warn('AdSense could not load this ad slot.', error);
        }
      });
    </script>}
  </body>
</html>
