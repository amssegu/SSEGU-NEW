---
import '../styles/work.css';
import '../styles/global.css';
import AdSlot from '../components/main/AdSlot.astro';
import CookieConsent from '../components/shared/CookieConsent.astro';
import SeoHead from '../components/shared/SeoHead.astro';
import { adsenseClient } from '../lib/adsense';
import type { JsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  section?: string;
  structuredData?: JsonLd;
}

const {
  title = 'SSEGU Work | Jobs · Careers · Skills · Opportunities',
  description = 'Jobs, career advice, skills and opportunities from SSEGU Work.',
  noindex = false,
  canonical,
  image,
  type = 'website',
  publishedAt,
  updatedAt,
  author,
  section,
  structuredData,
} = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [
  { label: 'Home', href: '/work/' },
  { label: 'Jobs', href: '/work/jobs/' },
  { label: 'Internships', href: '/work/internships/' },
  { label: 'Career Advice', href: '/work/career-advice/' },
  { label: 'Courses', href: '/work/courses/' },
  { label: 'CV Resources', href: '/work/cv-resources/' },
  { label: 'Employers', href: '/work/employers/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      image={image}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      author={author}
      section={section}
      structuredData={structuredData}
      themeColor="#082f78"
    />
    {adsenseClient && <link rel="preconnect" href="https://pagead2.googlesyndication.com" />}
    {adsenseClient && <link rel="preconnect" href="https://googleads.g.doubleclick.net" />}
    <title>{title}</title>
  </head>
  <body>
    <CookieConsent adsenseClient={adsenseClient} />
    <div class="work-site">
      <a class="skip-link work-skip-link" href="#work-main-content">
        Skip to content
      </a>
      <header class="work-header">
        <div class="work-header-inner">
          <a class="work-brand" href="/work/" aria-label="SSEGU Work home">
            <span class="work-brand-name">
              SSEGU <b>Work</b>
            </span>
            <span class="work-brand-subtitle">Jobs · Careers · Skills · Opportunities</span>
          </a>
          <button
            class="work-menu-toggle"
            type="button"
            aria-label="Toggle Work navigation"
            aria-expanded="false"
            aria-controls="work-primary-nav"
          >
            <span aria-hidden="true">☰</span>
          </button>
          <nav id="work-primary-nav" class="work-primary-nav" aria-label="Work navigation">
            {nav.map((item) => {
              const active =
                item.href === '/work/'
                  ? currentPath === item.href
                  : currentPath === item.href || currentPath.startsWith(`${item.href}`);
              return (
                <a
                  class="work-nav-link"
                  class:list:active={active}
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>
          <a class="work-news-link" href="/">
            Explore News <span aria-hidden="true">→</span>
          </a>
        </div>
      </header>
      <main id="work-main-content" class="work-main">
        <AdSlot placement="top" format="horizontal" />
        <slot />
        <AdSlot placement="section" format="horizontal" />
      </main>
      <footer class="work-footer">
        <div class="work-footer-inner">
          <div>
            <a class="work-footer-brand" href="/work/">
              SSEGU Work
            </a>
            <p>Helping people learn, prepare and get hired.</p>
            <small>
              Employer submissions enter private review. Approved jobs are created and published
              manually by editors.
            </small>
          </div>
          <div>
            <h2>Explore Work</h2>
            <a href="/work/jobs/">Jobs</a>
            <a href="/work/internships/">Internships</a>
            <a href="/work/career-advice/">Career advice</a>
          </div>
          <div>
            <h2>For employers</h2>
            <a href="/work/employers/">Why work with us</a>
            <a href="/work/submit-job/">Submit a job</a>
            <a href="/">Visit SSEGU News</a>
          </div>
          <div>
            <h2>Information</h2>
            <a href="/about/">About SSEGU</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy/">Privacy policy</a>
            <a href="/terms/">Terms of use</a>
          </div>
        </div>
      </footer>
    </div>
    <script is:inline>
      const workMenuButton = document.querySelector('.work-menu-toggle');
      const workNav = document.querySelector('#work-primary-nav');
      const closeWorkMenu = () => {
        workNav?.classList.remove('is-open');
        workMenuButton?.setAttribute('aria-expanded', 'false');
      };
      workMenuButton?.addEventListener('click', () => {
        const open = workMenuButton.getAttribute('aria-expanded') === 'true';
        workMenuButton.setAttribute('aria-expanded', String(!open));
        workNav?.classList.toggle('is-open', !open);
        if (!open) workNav?.querySelector('a')?.focus();
      });
      workNav?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeWorkMenu();
          workMenuButton?.focus();
        }
      });
      workNav
        ?.querySelectorAll('a')
        .forEach((link) => link.addEventListener('click', closeWorkMenu));
    </script>
    <script is:inline>
      const cookieConsentKey = 'ssegu-ad-consent';
      const cookieConsentDuration = 7 * 24 * 60 * 60 * 1000;
      const cookieConsent = document.querySelector('[data-cookie-consent]');
      const adsenseClient = cookieConsent?.dataset.adsenseClient;
      const adsAllowedHost = ['ssegu.com', 'www.ssegu.com'].includes(window.location.hostname);
      if (!adsAllowedHost) {
        cookieConsent?.setAttribute('hidden', '');
        document.querySelectorAll('.ad-unit').forEach((ad) => {
          ad.querySelectorAll('.adsbygoogle').forEach((slot) => slot.remove());
          const slot = ad.querySelector('.ad-slot');
          if (slot && !slot.querySelector('.ad-slot-placeholder')) {
            slot.innerHTML = '<div class="ad-slot-placeholder" aria-hidden="true">Ad space</div>';
          }
        });
      }
      const readConsent = () => {
        const value = document.cookie
          .split('; ')
          .find((entry) => entry.startsWith(`${cookieConsentKey}=`))
          ?.split('=')[1];
        if (!value) return null;
        try {
          const consent = JSON.parse(decodeURIComponent(value));
          return consent.expires > Date.now() ? consent : null;
        } catch {
          return null;
        }
      };
      const saveConsent = (allowed) => {
        const value = encodeURIComponent(
          JSON.stringify({ allowed, expires: Date.now() + cookieConsentDuration }),
        );
        document.cookie = `${cookieConsentKey}=${value}; max-age=${cookieConsentDuration / 1000}; path=/; samesite=lax`;
      };
      const requestAds = () => {
        if (
          !adsAllowedHost ||
          !adsenseClient ||
          document.querySelector('script[data-ssegu-adsense]')
        )
          return;
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`;
        script.crossOrigin = 'anonymous';
        script.dataset.sseguAdsense = 'true';
        script.onload = () => {
          document.querySelectorAll('.adsbygoogle:not([data-ad-requested])').forEach((ad) => {
            ad.setAttribute('data-ad-requested', '1');
            try {
              (window.adsbygoogle = window.adsbygoogle || []).push({});
            } catch (error) {
              ad.removeAttribute('data-ad-requested');
              console.warn('AdSense could not load this ad slot.', error);
            }
          });
        };
        document.head.appendChild(script);
      };
      const consent = readConsent();
      if (adsAllowedHost && consent?.allowed) requestAds();
      if (adsAllowedHost && !consent && cookieConsent) cookieConsent.hidden = false;
      cookieConsent?.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
        saveConsent(true);
        cookieConsent.hidden = true;
        requestAds();
      });
      cookieConsent?.querySelector('[data-cookie-decline]')?.addEventListener('click', () => {
        saveConsent(false);
        cookieConsent.hidden = true;
      });
    </script>
  </body>
</html>
