---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  section?: string;
  structuredData?: import('../lib/seo').JsonLd;
}

const {
  title,
  description,
  noindex = false,
  canonical,
  image,
  type = 'website',
  publishedAt,
  updatedAt,
  author,
  section,
  structuredData,
} = Astro.props;
const nav = [
  { label: 'Home', href: '/' },
  { label: 'News', href: '/news/', menu: true },
  { label: 'Business', href: '/category/business/', menu: true },
  { label: 'Politics', href: '/category/politics/', menu: true },
  { label: 'Technology', href: '/category/technology/', menu: true },
  { label: 'Education', href: '/category/education/', menu: true },
  { label: 'Lifestyle', href: '/category/lifestyle/', menu: true },
];
const currentPath = Astro.url.pathname;
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  canonical={canonical}
  image={image}
  type={type}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  author={author}
  section={section}
  structuredData={structuredData}
>
  <header class="site-header">
    <div class="utility-bar">
      <div class="shell utility-inner">
        <time id="current-date" datetime={new Date().toISOString()}>
          ▣ Loading date…
        </time>
        <span id="kampala-weather" aria-live="polite">
          ☁ Kampala · Loading weather…
        </span>
        <nav aria-label="Utility navigation">
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/search/" aria-label="Search">
            ⌕
          </a>
        </nav>
      </div>
    </div>
    <div class="shell masthead">
      <a class="brand" href="/" aria-label="SSEGU home">
        <span class="brand-line">
          <picture class="brand-logo">
            <source srcset="/uploads/logo.avif" type="image/avif" />
            <img src="/uploads/logo.webp" alt="SSEGU" width="400" height="400" />
          </picture>
        </span>
      </a>
      <div class="masthead-banner">
        <picture class="masthead-banner-image">
          <source srcset="/uploads/article-ict.avif" type="image/avif" />
          <source srcset="/uploads/article-ict.webp" type="image/webp" />
          <img src="/uploads/article-ict.webp" alt="" width="1800" height="1200" />
        </picture>
        <span>
          A more informed Uganda
          <br />
          <em>A brighter future</em>
        </span>
      </div>
    </div>
  </header>
  <div class="nav-wrap">
    <div class="shell nav-inner">
      <button
        class="menu-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span aria-hidden="true">☰</span>
      </button>
      <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
        {nav.map((item) => (
          <a
            class:list:active={
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
            }
            href={item.href}
          >
            {item.label}
          </a>
        ))}
        <a class="nav-work" href="/work/">
          SSEGU Work
        </a>
        <a class="nav-live-tv" href="/#live-tv">
          <span aria-hidden="true">●</span> Live TV
        </a>
      </nav>
    </div>
  </div>
  <main id="main-content" class="site-main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="shell footer-grid">
      <div>
        <a class="footer-brand" href="/">
          SSEGU
        </a>
        <p>Inform. Educate. Empower.</p>
        <small>Uganda-focused news, information and opportunities.</small>
      </div>
      <div>
        <h2>Explore</h2>
        <a href="/news/">Latest news</a>
        <a href="/about/">About SSEGU</a>
        <a href="/contact/">Contact</a>
      </div>
      <div>
        <h2>Legal</h2>
        <a href="/privacy/">Privacy policy</a>
        <a href="/terms/">Terms</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </div>
  </footer>
  <script is:inline>
    const dateElement = document.querySelector('#current-date');
    const weatherElement = document.querySelector('#kampala-weather');
    const weatherLabels = {
      0: 'Clear sky',
      1: 'Mainly clear',
      2: 'Partly cloudy',
      3: 'Overcast',
      45: 'Foggy',
      48: 'Rime fog',
      51: 'Light drizzle',
      53: 'Drizzle',
      55: 'Heavy drizzle',
      61: 'Light rain',
      63: 'Rain',
      65: 'Heavy rain',
      80: 'Rain showers',
      81: 'Rain showers',
      82: 'Heavy showers',
      95: 'Thunderstorm',
      96: 'Thunderstorm with hail',
      99: 'Thunderstorm with hail',
    };
    const kampalaDate = new Intl.DateTimeFormat('en-UG', {
      dateStyle: 'full',
      timeZone: 'Africa/Kampala',
    }).format(new Date());
    if (dateElement) {
      dateElement.textContent = `▣ ${kampalaDate}`;
      dateElement.dateTime = new Date().toISOString();
    }
    fetch(
      'https://api.open-meteo.com/v1/forecast?latitude=0.3476&longitude=32.5825&current=temperature_2m,weather_code&temperature_unit=celsius&timezone=Africa%2FKampala',
    )
      .then((response) => {
        if (!response.ok) throw new Error('Weather request failed');
        return response.json();
      })
      .then((data) => {
        const temperature = Math.round(data.current.temperature_2m);
        const condition = weatherLabels[data.current.weather_code] ?? 'Current conditions';
        if (weatherElement) {
          weatherElement.textContent = `☁ Kampala · ${temperature}°C · ${condition}`;
          weatherElement.title = 'Current weather from Open-Meteo';
        }
      })
      .catch(() => {
        if (weatherElement) weatherElement.textContent = '☁ Kampala · Weather unavailable';
      });

    const menuButton = document.querySelector('.menu-toggle');
    const nav = document.querySelector('#primary-nav');
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      nav?.classList.toggle('is-open', !open);
      if (!open) nav?.querySelector('a')?.focus();
    });
    nav?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        nav.classList.remove('is-open');
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.focus();
      }
    });
  </script>
</BaseLayout>
