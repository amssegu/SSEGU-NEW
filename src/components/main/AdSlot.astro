---
interface Props {
  placement?: 'top' | 'sidebar' | 'section' | 'article';
  format?: 'auto' | 'horizontal' | 'rectangle';
  minHeight?: number;
}

const adsenseEnabled = import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true';
const client = adsenseEnabled ? import.meta.env.PUBLIC_ADSENSE_CLIENT : undefined;
const slot = adsenseEnabled ? import.meta.env.PUBLIC_ADSENSE_SLOT : undefined;
const {
  placement = 'section',
  format = 'auto',
  minHeight = placement === 'sidebar' ? 250 : 90,
} = Astro.props;
---

<aside class:list={['ad-unit', `ad-${placement}`]} aria-label="Advertisement">
  <span class="ad-label">Advertisement</span>
  <div class="ad-slot" style={`min-height: ${minHeight}px`}>
    {client && slot ? (
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format={
          format === 'rectangle' ? 'rectangle' : format === 'horizontal' ? 'horizontal' : 'auto'
        }
        data-full-width-responsive="true"
      ></ins>
    ) : (
      <div class="ad-slot-placeholder" aria-hidden="true">
        Ad space
      </div>
    )}
  </div>
</aside>
