---
import { adsenseClient, adsenseSlot } from '../../lib/adsense';

interface Props {
  placement?: 'top' | 'sidebar' | 'section' | 'article';
  format?: 'auto' | 'horizontal' | 'rectangle';
  minHeight?: number;
}

const {
  placement = 'section',
  format = 'auto',
  minHeight = placement === 'sidebar' ? 250 : 90,
} = Astro.props;
---

<aside class:list={['ad-unit', `ad-${placement}`]} aria-label="Advertisement">
  <span class="ad-label">Advertisement</span>
  <div class="ad-slot" style={`min-height: ${minHeight}px`}>
    {adsenseClient && adsenseSlot ? (
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={adsenseClient}
        data-ad-slot={adsenseSlot}
        data-ad-format={
          format === 'rectangle' ? 'rectangle' : format === 'horizontal' ? 'horizontal' : 'auto'
        }
        data-full-width-responsive="true"
      ></ins>
    ) : (
      <div class="ad-slot-placeholder" aria-hidden="true">
        Ad space
      </div>
    )}
  </div>
</aside>
