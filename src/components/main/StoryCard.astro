---
import type { Article } from '../../lib/articles';
import { formatDate, label } from '../../lib/articles';
interface Props {
  article: Article;
  compact?: boolean;
}
const { article, compact = false } = Astro.props;
---

<article class:list={['story-card', { compact }]}>
  <a href={`/${article.slug}/`} class="story-image">
    <picture>
      {!article.image.startsWith('http') && <source srcset={article.imageAvif} type="image/avif" />}
      {!article.image.startsWith('http') && <source srcset={article.image} type="image/webp" />}
      <img
        src={article.image}
        alt={`Illustration for ${article.title}`}
        width="640"
        height={compact ? 480 : 360}
        loading="lazy"
      />
    </picture>
  </a>
  <div class="story-card-copy">
    <div class="story-taxonomy" aria-label="Article categories">
      {article.categories.map((category) => (
        <a class:list={['category-label', `category-${category}`]} href={`/category/${category}/`}>
          {label(category)}
        </a>
      ))}
    </div>
    <h3>
      <a href={`/${article.slug}/`}>{article.title}</a>
    </h3>
    <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
  </div>
</article>
