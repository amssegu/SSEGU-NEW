---
import { getPublishedArticles } from '../../lib/articles';
const latest = (await getPublishedArticles()).slice(0, 5);
---

<div class="breaking shell" aria-label="Latest news">
  <strong>⚡ BREAKING NEWS</strong>
  <div class="breaking-window">
    <div class="breaking-track">
      {latest.map((article) => (
        <a href={`/${article.slug}/`}>
          {article.title} <span aria-hidden="true">→</span>
        </a>
      ))}
      {latest.map((article) => (
        <a href={`/${article.slug}/`} aria-hidden="true" tabindex="-1">
          {article.title} <span aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</div>
