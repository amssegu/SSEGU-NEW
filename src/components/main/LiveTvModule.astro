---
import { liveTvChannels } from '../../lib/live-tv';
---

<section id="live-tv" class="live-tv-module shell" aria-labelledby="live-tv-title">
  <div class="live-tv-intro">
    <div>
      <p class="live-tv-kicker">
        <span aria-hidden="true"></span> SSEGU Live
      </p>
      <h2 id="live-tv-title">Watch live TV</h2>
      <p class="live-tv-dek">
        Stay close to the stories, voices and channels shaping Uganda right now.
      </p>
    </div>
    <a class="live-tv-link" href="/tv/">
      Live channels <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="live-tv-channels" aria-label="Live TV channels">
    <div class="live-tv-channels-heading">
      <h3>Live channels</h3>
      <span>{liveTvChannels.length} available</span>
    </div>
    <div class="live-tv-channel-grid">
      {liveTvChannels.map((channel) => (
        <a
          class="live-tv-card"
          href={`/tv/${channel.id}/`}
          style={`--channel-color: ${channel.color}`}
        >
          <span class="live-tv-card-poster" aria-hidden="true">
            <span class="live-tv-card-badge">LIVE</span>
            <span class="live-tv-card-overlay">
              <span class="live-tv-card-play">▶</span>
            </span>
          </span>
          <span class="live-tv-card-info">
            <strong>{channel.name}</strong>
            <small>{channel.category}</small>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
