---

<section id="live-tv" class="live-tv-module shell" aria-labelledby="live-tv-title">
  <div class="live-tv-intro">
    <div>
      <p class="live-tv-kicker"><span aria-hidden="true"></span> SSEGU Live</p>
      <h2 id="live-tv-title">Watch live TV</h2>
      <p class="live-tv-dek">Stay close to the stories, voices and channels shaping Uganda right now.</p>
    </div>
    <a class="live-tv-link" href="#live-tv">Live channels <span aria-hidden="true">↗</span></a>
  </div>

  <div class="live-tv-legacy-player" data-live-tv-player>
    <div class="live-tv-legacy-video-wrap">
      <video class="live-tv-legacy-video" data-live-tv-video playsinline controls preload="metadata"></video>
      <div class="live-tv-legacy-overlay" data-live-tv-play-overlay>
        <button class="live-tv-legacy-play" data-live-tv-play type="button" aria-label="Play live TV">▶</button>
        <div class="live-tv-legacy-hint" data-live-tv-hint>Choose a channel below</div>
      </div>
      <div class="live-tv-legacy-overlay is-hidden" data-live-tv-load-overlay>
        <div class="live-tv-legacy-load-text" data-live-tv-load-text>Connecting…</div>
      </div>
      <div class="live-tv-legacy-overlay is-hidden" data-live-tv-error-overlay>
        <div class="live-tv-legacy-error-box">
          <p>Unable to load stream. Please try again.</p>
          <button class="live-tv-legacy-retry" data-live-tv-retry type="button">Retry</button>
        </div>
      </div>
    </div>
    <div class="live-tv-legacy-meta">
      <span class="live-tv-card-badge">● LIVE</span>
      <span data-live-tv-current-category>Select a channel</span>
    </div>
  </div>

  <div class="live-tv-channels" aria-label="Live TV channels">
    <div class="live-tv-channels-heading">
      <h3>Live channels</h3>
      <span>{channels.length} available</span>
    </div>
    <div class="live-tv-channel-grid">
      {channels.map((channel) => (
        <button class="live-tv-card" type="button" data-live-tv-channel={channel.id} data-live-tv-name={channel.name} data-live-tv-category={channel.category} data-live-tv-stream={channel.stream} style={`--channel-color: ${channel.color}`}>
          <span class="live-tv-card-poster" aria-hidden="true">
            <span class="live-tv-card-badge">LIVE</span>
            <span class="live-tv-card-overlay"><span class="live-tv-card-play">▶</span></span>
          </span>
          <span class="live-tv-card-info"><strong>{channel.name}</strong><small>{channel.category}</small></span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  import Hls from 'hls.js';

  const HlsPlayer = Hls;
  const player = document.querySelector<HTMLElement>('[data-live-tv-player]');
  const video = player?.querySelector<HTMLVideoElement>('[data-live-tv-video]');
  const playOverlay = player?.querySelector<HTMLElement>('[data-live-tv-play-overlay]');
  const loadOverlay = player?.querySelector<HTMLElement>('[data-live-tv-load-overlay]');
  const errorOverlay = player?.querySelector<HTMLElement>('[data-live-tv-error-overlay]');
  const loadText = player?.querySelector<HTMLElement>('[data-live-tv-load-text]');
  const playButton = player?.querySelector<HTMLButtonElement>('[data-live-tv-play]');
  const retryButton = player?.querySelector<HTMLButtonElement>('[data-live-tv-retry]');
  const currentCategory = player?.querySelector<HTMLElement>('[data-live-tv-current-category]');
  const cards = [...document.querySelectorAll<HTMLButtonElement>('[data-live-tv-channel]')];
  let currentHls: Hls | null = null;
  let loadTimeout: number | undefined;
  let activeCard: HTMLButtonElement | undefined;
  let streamUrl = '';
  let channelName = '';

  function showOnly(which: 'play' | 'load' | 'error' | 'none') {
    playOverlay?.classList.toggle('is-hidden', which !== 'play');
    loadOverlay?.classList.toggle('is-hidden', which !== 'load');
    errorOverlay?.classList.toggle('is-hidden', which !== 'error');
  }
  function destroyHls() {
    if (currentHls) { try { currentHls.destroy(); } catch {} currentHls = null; }
    if (loadTimeout) { window.clearTimeout(loadTimeout); loadTimeout = undefined; }
  }
  function showError() { destroyHls(); showOnly('error'); }
  function showLoading(text = 'Connecting…') { if (loadText) loadText.textContent = text; showOnly('load'); }
  function attachStream(url: string, autoPlay: boolean) {
    destroyHls();
    if (!video) return;
    video.removeAttribute('src');
    try { video.load(); } catch {}
    let resolved = false;
    const onReady = () => {
      if (resolved) return;
      resolved = true;
      if (loadTimeout) { window.clearTimeout(loadTimeout); loadTimeout = undefined; }
      if (autoPlay) video.play().then(() => showOnly('none')).catch(() => showOnly('play'));
    };
    loadTimeout = window.setTimeout(() => { if (!resolved) showError(); }, 18000);
    if (HlsPlayer.isSupported()) {
      currentHls = new HlsPlayer({ enableWorker: true, lowLatencyMode: true, backBufferLength: 60, maxBufferLength: 30, manifestLoadingTimeOut: 12000, levelLoadingTimeOut: 12000, fragLoadingTimeOut: 15000 });
      currentHls.loadSource(url);
      currentHls.attachMedia(video);
      currentHls.on(HlsPlayer.Events.MANIFEST_PARSED, onReady);
      currentHls.on(HlsPlayer.Events.ERROR, (_event, data) => {
        if (!data.fatal) return;
        if (data.type === HlsPlayer.ErrorTypes.NETWORK_ERROR) { try { currentHls?.startLoad(); } catch { showError(); } }
        else if (data.type === HlsPlayer.ErrorTypes.MEDIA_ERROR) { try { currentHls?.recoverMediaError(); } catch { showError(); } }
        else showError();
      });
    } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = url;
      video.addEventListener('loadedmetadata', onReady, { once: true });
      video.addEventListener('error', showError, { once: true });
    } else {
      showError();
    }
    video.addEventListener('error', () => { if (!resolved) showError(); }, { once: true });
  }
  function startPlay() { showLoading(`Connecting to ${channelName}…`); attachStream(streamUrl, true); }
  function selectChannel(card: HTMLButtonElement) {
    activeCard = card;
    cards.forEach((item) => item.classList.toggle('is-active', item === card));
    channelName = card.dataset.liveTvName ?? 'Live TV';
    streamUrl = card.dataset.liveTvStream ?? '';
    if (currentCategory) currentCategory.textContent = card.dataset.liveTvCategory ?? '';
    startPlay();
  }
  cards.forEach((card) => card.addEventListener('click', () => selectChannel(card)));
  playButton?.addEventListener('click', (event) => { event.preventDefault(); startPlay(); });
  playOverlay?.addEventListener('click', (event) => { if (event.target === playOverlay) startPlay(); });
  retryButton?.addEventListener('click', (event) => { event.preventDefault(); startPlay(); });
  const requested = cards.find((card) => card.dataset.liveTvChannel === new URLSearchParams(window.location.search).get('ch'));
  if (requested) selectChannel(requested);
  else showOnly('play');
</script>
