---
import type { Article } from '../../lib/articles';
interface Props {
  articles: Article[];
}
const { articles } = Astro.props;
---

<section class="top-stories" aria-labelledby="top-stories-title">
  <h2 id="top-stories-title">Top Stories</h2>
  <ol>
    {articles.slice(0, 6).map((article) => (
      <li>
        <a class="top-story-card" href={`/${article.slug}/`}>
          <picture>
            {!article.image.startsWith('http') && (
              <source srcset={article.imageAvif} type="image/avif" />
            )}
            {!article.image.startsWith('http') && (
              <source srcset={article.image} type="image/webp" />
            )}
            <img
              src={article.image}
              alt=""
              loading="lazy"
              decoding="async"
              width="160"
              height="90"
            />
          </picture>
          <strong>{article.title}</strong>
        </a>
      </li>
    ))}
  </ol>
</section>
