---
import { absoluteUrl, canonicalFor, jsonLd, type JsonLd } from '../../lib/seo';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  section?: string;
  structuredData?: JsonLd;
  themeColor?: string;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  image,
  type = 'website',
  publishedAt,
  updatedAt,
  author,
  section,
  structuredData,
  themeColor = '#2b0b57',
} = Astro.props;
const resolvedCanonical = canonical ?? canonicalFor(Astro.url.pathname);
const resolvedImage = image ? absoluteUrl(image) : undefined;
---

<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<meta name="theme-color" content={themeColor} />
<link rel="icon" type="image/avif" href="/uploads/logo.avif" />
<link rel="icon" type="image/webp" href="/uploads/logo.webp" />
<link rel="canonical" href={resolvedCanonical} />
<meta property="og:site_name" content="SSEGU" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={resolvedCanonical} />
{resolvedImage && <meta property="og:image" content={resolvedImage} />}
<meta name="twitter:card" content={resolvedImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{resolvedImage && <meta name="twitter:image" content={resolvedImage} />}
{type === 'article' && publishedAt && (
  <meta property="article:published_time" content={publishedAt} />
)}
{type === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt} />}
{type === 'article' && author && <meta property="article:author" content={author} />}
{type === 'article' && section && <meta property="article:section" content={section} />}
{Astro.url.pathname.startsWith('/tv') && (
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous" />
)}
{structuredData && <script type="application/ld+json" set:html={jsonLd(structuredData)} />}
