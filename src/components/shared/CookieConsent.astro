---
interface Props {
  adsenseClient?: string;
}

const { adsenseClient } = Astro.props;
---

<aside
  class="cookie-consent"
  data-cookie-consent
  data-adsense-client={adsenseClient}
  role="dialog"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-description"
  hidden
>
  <div class="cookie-consent-copy">
    <p id="cookie-consent-title" class="cookie-consent-title">
      A quick note about cookies
    </p>
    <p id="cookie-consent-description">
      This site uses cookies to keep SSEGU working and remember your preferences.
      <a href="/privacy/">Learn more</a>
    </p>
  </div>
  <div class="cookie-consent-actions">
    <button
      type="button"
      class="cookie-consent-button cookie-consent-button-primary"
      data-cookie-accept
    >
      Okay
    </button>
    <button type="button" class="cookie-consent-button" data-cookie-decline>
      Dismiss
    </button>
  </div>
</aside>
