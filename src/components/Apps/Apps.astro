---
const fallbackImage = 'https://via.placeholder.com/640x400?text=APP';
---

<div class="apps-wrapper">
  <header class="apps-header">
    <h1>📱 Apps Download Center</h1>
    <p>Discover useful apps here @ssegu apps.</p>
  </header>

  <div class="apps-main-layout">
    <article class="apps-blog">
      <div class="blog-label">📖 App Guide</div>
      <h2>WhatsApp for Windows</h2>
      <p class="blog-intro">
        Stay connected from your computer with the WhatsApp desktop experience for Windows.
      </p>
      <p>
        WhatsApp is one of the most popular communication applications for staying connected with
        friends, family, colleagues and businesses.
      </p>
      <p>
        With <strong>WhatsApp for Windows</strong>, you can continue your conversations directly
        from your PC without constantly switching between your phone and computer.
      </p>
      <p>
        The desktop version can be useful when working, studying or spending long periods at your
        computer. It provides a convenient way to access your WhatsApp conversations from Windows.
      </p>

      <h3>Why use WhatsApp on Windows?</h3>
      <ul>
        <li>Use WhatsApp directly from your computer.</li>
        <li>Continue conversations without switching devices.</li>
        <li>Communicate with your contacts from your desktop.</li>
        <li>Useful for work, study and everyday messaging.</li>
        <li>Available as a free communication application.</li>
      </ul>

      <div class="app-info">
        <div class="app-info-row">
          <span class="app-info-label">App</span>
          <span class="app-info-value">WhatsApp</span>
        </div>
        <div class="app-info-row">
          <span class="app-info-label">Version</span>
          <span class="app-info-value">2.2445.7.0</span>
        </div>
        <div class="app-info-row">
          <span class="app-info-label">Platform</span>
          <span class="app-info-value">Windows</span>
        </div>
        <div class="app-info-row">
          <span class="app-info-label">Category</span>
          <span class="app-info-value">Communication</span>
        </div>
        <div class="app-info-row">
          <span class="app-info-label">Price</span>
          <span class="app-info-value">Free</span>
        </div>
      </div>

      <a
        class="blog-download"
        href="https://www.ssegu.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        ⬇ DOWNLOAD WHATSAPP
      </a>
    </article>

    <section class="apps-feed-area" id="apps" aria-labelledby="apps-feed-heading">
      <div class="feed-heading">
        <h2 id="apps-feed-heading">Latest Apps</h2>
        <span class="feed-count">Updated apps</span>
      </div>

      <div id="appsGrid" class="apps-grid" aria-live="polite">
        <div class="loading-box">
          <div class="loading-spinner" aria-hidden="true"></div>
          Loading apps…
        </div>
      </div>

      <div class="load-more-area">
        <button id="loadMoreBtn" type="button">
          LOAD MORE APPS
        </button>
      </div>
    </section>
  </div>
</div>

<script define:vars={{ fallbackImage }}>
  const appsGrid = document.querySelector('#appsGrid');
  const loadMoreButton = document.querySelector('#loadMoreBtn');
  const batchSize = 12;
  let allApps = [];
  let currentIndex = 0;

  const textContent = (value) => (typeof value === 'string' ? value : '');

  const cleanDescription = (value) => {
    const div = document.createElement('div');
    div.innerHTML = value;
    const text = (div.textContent || '').replace(/\s+/g, ' ').trim();
    return text
      ? `${text.slice(0, 155).trim()}${text.length > 155 ? '…' : ''}`
      : 'Learn more about this app and access its download option.';
  };

  const normalizeApp = (entry) => {
    if (!entry) return null;
    const title = textContent(entry.title?.$t) || 'Untitled App';
    const alternate = entry.link?.find((link) => link.rel === 'alternate');
    const image =
      textContent(entry.media$thumbnail?.url).replace('/s72-c/', '/s640/') || fallbackImage;
    const description = cleanDescription(
      textContent(entry.summary?.$t) || textContent(entry.content?.$t),
    );
    const date = new Date(textContent(entry.published?.$t) || '2000-01-01').getTime();
    return { title, url: textContent(alternate?.href) || '#', image, description, date };
  };

  const showMessage = (message, strong = false) => {
    if (!appsGrid) return;
    appsGrid.replaceChildren();
    const messageBox = document.createElement('div');
    messageBox.className = 'no-results';
    if (strong) {
      const heading = document.createElement('strong');
      heading.textContent = message;
      messageBox.append(heading, document.createElement('br'), document.createElement('br'));
      messageBox.append('Please refresh the page and try again.');
    } else {
      messageBox.textContent = message;
    }
    appsGrid.append(messageBox);
  };

  const updateLoadMore = () => {
    if (loadMoreButton) loadMoreButton.hidden = currentIndex >= allApps.length;
  };

  const createAppCard = (app) => {
    if (!appsGrid) return;
    const card = document.createElement('article');
    card.className = 'app-card';

    const imageWrap = document.createElement('div');
    imageWrap.className = 'app-image';
    const image = document.createElement('img');
    image.src = app.image;
    image.alt = app.title;
    image.loading = 'lazy';
    image.onerror = () => {
      image.src = fallbackImage;
    };
    imageWrap.append(image);

    const content = document.createElement('div');
    content.className = 'app-content';
    const title = document.createElement('h3');
    title.className = 'app-title';
    title.textContent = app.title;
    const description = document.createElement('p');
    description.className = 'app-description';
    description.textContent = app.description;
    const link = document.createElement('a');
    link.className = 'download-btn';
    link.href = app.url;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    const icon = document.createElement('span');
    icon.className = 'download-icon';
    icon.textContent = '⬇';
    link.append(icon, 'DOWNLOAD APP');
    content.append(title, description, link);
    card.append(imageWrap, content);
    appsGrid.append(card);
  };

  const renderApps = (reset = false) => {
    if (!appsGrid) return;
    if (reset) {
      currentIndex = 0;
      appsGrid.replaceChildren();
    }
    const nextApps = allApps.slice(currentIndex, currentIndex + batchSize);
    if (reset && nextApps.length === 0) {
      showMessage('No apps are currently available.');
      if (loadMoreButton) loadMoreButton.hidden = true;
      return;
    }
    nextApps.forEach(createAppCard);
    currentIndex += nextApps.length;
    updateLoadMore();
  };

  const handleAppsFeed = (json) => {
    try {
      allApps = (json?.feed?.entry || [])
        .map(normalizeApp)
        .filter(Boolean)
        .sort((a, b) => b.date - a.date);
      renderApps(true);
    } catch (error) {
      console.error('Apps feed error:', error);
      showMessage('Unable to load apps.', true);
      if (loadMoreButton) loadMoreButton.hidden = true;
    }
  };

  loadMoreButton?.addEventListener('click', () => renderApps());

  const callbackName = `sseguAppsFeed_${Date.now()}`;
  window[callbackName] = handleAppsFeed;
  const feedScript = document.createElement('script');
  feedScript.src = `https://apps.ssegu.com/feeds/posts/default/-/apps?alt=json-in-script&max-results=150&callback=${callbackName}`;
  feedScript.onerror = () => {
    showMessage('Unable to load apps.', true);
    if (loadMoreButton) loadMoreButton.hidden = true;
  };
  document.body.append(feedScript);
</script>

<style>
  .apps-wrapper {
    width: 100%;
    max-width: 1250px;
    margin: auto;
    padding: 30px 24px 64px;
  }
  .apps-header {
    background: linear-gradient(135deg, #12243f, #1d416f);
    color: #fff;
    padding: 30px 20px;
    border-radius: 8px;
    margin-bottom: 28px;
    text-align: left;
    box-shadow: 0 12px 28px rgb(18 36 63 / 18%);
  }
  .apps-header h1 {
    margin: 0 0 8px;
    font-size: clamp(30px, 5vw, 48px);
    letter-spacing: -0.04em;
    font-weight: 800;
  }
  .apps-header p {
    margin: 0;
    color: #d8d8d8;
    font-size: 15px;
  }
  .apps-main-layout {
    display: grid;
    grid-template-columns: minmax(280px, 390px) minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }
  .apps-blog {
    background: #fff;
    border: 1px solid #dce2e9;
    border-radius: 8px;
    padding: 22px;
    box-shadow: 0 8px 22px rgb(18 36 63 / 7%);
    position: sticky;
    top: 70px;
    overflow: hidden;
  }
  .blog-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #edf2f7;
    color: #1d416f;
    padding: 7px 11px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 14px;
  }
  .apps-blog h2 {
    margin: 0 0 10px;
    font-size: 24px;
    line-height: 1.25;
    font-weight: 800;
  }
  .apps-blog .blog-intro,
  .apps-blog p {
    margin: 0 0 18px;
    color: #666;
    font-size: 14px;
    line-height: 1.65;
  }
  .apps-blog h3 {
    margin: 20px 0 10px;
    font-size: 17px;
  }
  .apps-blog ul {
    margin: 8px 0 18px;
    padding-left: 19px;
  }
  .apps-blog li {
    color: #555;
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 6px;
  }
  .app-info {
    background: #f6f7f8;
    border-radius: 12px;
    padding: 13px;
    margin-top: 16px;
  }
  .app-info-row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid #e4e6e8;
    font-size: 12px;
  }
  .app-info-row:last-child {
    border-bottom: 0;
  }
  .app-info-label {
    color: #777;
  }
  .app-info-value {
    font-weight: 700;
    color: #222;
    text-align: right;
  }
  .blog-download,
  .download-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    text-align: center;
    text-decoration: none;
    background: #d95c4b;
    color: #fff;
    padding: 11px 8px;
    border-radius: 5px;
    font-size: 13px;
    font-weight: 800;
    transition: 0.2s ease;
  }
  .blog-download {
    min-height: 52px;
    margin-top: 16px;
    border-radius: 11px;
    font-size: 14px;
  }
  .blog-download:hover,
  .download-btn:hover,
  #loadMoreBtn:hover {
    background: #b84438;
    color: #fff;
    transform: translateY(-2px);
  }
  .feed-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 0 0 14px;
  }
  .feed-heading h2 {
    margin: 0;
    font-size: 21px;
    font-weight: 800;
  }
  .feed-count {
    background: #fff;
    padding: 7px 11px;
    border-radius: 50px;
    font-size: 11px;
    color: #666;
    box-shadow: 0 2px 8px rgb(0 0 0 / 5%);
  }
  .apps-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .app-card {
    background: #fff;
    border: 1px solid #dce2e9;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 6px 18px rgb(18 36 63 / 6%);
    transition: 0.25s ease;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .app-card:hover {
    transform: translateY(-4px);
    border-color: #1d416f;
    box-shadow: 0 12px 26px rgb(18 36 63 / 12%);
  }
  .app-image {
    width: 100%;
    height: 150px;
    overflow: hidden;
    background: #e9ecef;
  }
  .app-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: 0.3s ease;
  }
  .app-card:hover .app-image img {
    transform: scale(1.04);
  }
  .app-content {
    padding: 14px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .app-title {
    margin: 0 0 7px;
    font-size: 16px;
    line-height: 1.3;
    font-weight: 800;
  }
  .app-description {
    font-size: 12px;
    line-height: 1.55;
    color: #666;
    margin: 0 0 14px;
    flex: 1;
  }
  .download-icon {
    font-size: 18px;
    margin-right: 7px;
  }
  .load-more-area {
    text-align: center;
    margin: 22px 0 0;
  }
  #loadMoreBtn {
    border: 0;
    background: #12243f;
    color: #fff;
    padding: 14px 25px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 800;
    transition: 0.2s ease;
  }
  #loadMoreBtn[hidden] {
    display: none;
  }
  .loading-box,
  .no-results {
    grid-column: 1 / -1;
    text-align: center;
    padding: 50px 20px;
    color: #666;
    background: #fff;
    border-radius: 15px;
  }
  .loading-spinner {
    width: 38px;
    height: 38px;
    border: 4px solid #ddd;
    border-top-color: #111;
    border-radius: 50%;
    animation: apps-spin 0.8s linear infinite;
    margin: 0 auto 15px;
  }
  @keyframes apps-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (max-width: 900px) {
    .apps-main-layout {
      grid-template-columns: 300px minmax(0, 1fr);
      gap: 16px;
    }
    .apps-grid {
      grid-template-columns: 1fr;
    }
    .app-image {
      height: 145px;
    }
  }
  @media (max-width: 700px) {
    .apps-wrapper {
      padding: 10px 10px 35px;
    }
    .apps-header {
      padding: 24px 15px;
      border-radius: 15px;
      margin-bottom: 15px;
    }
    .apps-header h1 {
      font-size: 24px;
    }
    .apps-header p {
      font-size: 13px;
    }
    .apps-main-layout {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .apps-blog {
      position: relative;
      top: auto;
      width: 100%;
      padding: 18px;
      border-radius: 15px;
    }
    .apps-blog h2 {
      font-size: 21px;
    }
    .apps-blog .blog-intro,
    .apps-blog p {
      font-size: 13px;
    }
    .apps-blog h3 {
      font-size: 16px;
    }
    .apps-blog li {
      font-size: 12px;
    }
    .apps-feed-area {
      width: 100%;
    }
    .feed-heading {
      margin-bottom: 11px;
    }
    .feed-heading h2 {
      font-size: 19px;
    }
    .apps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 11px;
    }
    .app-image {
      height: 135px;
    }
    .app-content {
      padding: 11px;
    }
    .app-title {
      font-size: 14px;
    }
    .app-description {
      font-size: 11px;
      line-height: 1.5;
    }
    .download-btn {
      min-height: 48px;
      font-size: 12px;
    }
  }
  @media (max-width: 430px) {
    .apps-header h1 {
      font-size: 22px;
    }
    .app-image {
      height: 125px;
    }
    .app-title {
      font-size: 13px;
    }
    .download-btn {
      min-height: 46px;
      font-size: 11px;
    }
    .download-icon {
      font-size: 16px;
    }
  }
  @media (max-width: 340px) {
    .apps-grid {
      grid-template-columns: 1fr;
    }
    .app-image {
      height: 180px;
    }
    .app-title {
      font-size: 16px;
    }
    .app-description {
      font-size: 12px;
    }
    .download-btn {
      font-size: 13px;
    }
  }
</style>
