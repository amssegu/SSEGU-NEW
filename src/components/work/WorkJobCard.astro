---
import type { WorkJob } from '../../lib/work';
import { formatWorkDate, getWorkJobStatus, workJobStatusLabel } from '../../lib/work';
import WorkJobSource from './WorkJobSource.astro';

interface Props {
  job: WorkJob;
  compact?: boolean;
}

const { job, compact = false } = Astro.props;
const displayStatus = getWorkJobStatus(job);
---

<article
  class:list={[
    'work-job-card',
    compact && 'is-compact',
    displayStatus !== 'active' && 'is-expired',
  ]}
>
  <div class="work-job-icon" aria-hidden="true">
    ▣
  </div>
  <div class="work-job-content">
    <div class="work-job-heading">
      <div>
        <p class="work-card-kicker">{job.category}</p>
        <h3>
          <a href={`/work/jobs/${job.slug}/`}>{job.title}</a>
        </h3>
        <p class="work-job-employer">{job.employer}</p>
      </div>
      <span class:list={['work-status-badge', displayStatus !== 'active' && 'is-expired']}>
        {workJobStatusLabel(displayStatus)}
      </span>
    </div>
    {!compact && job.description && <p class="work-job-description">{job.description}</p>}
    <div class="work-job-meta">
      <span>Location: {job.location}</span>
      <span>Work mode: {job.arrangement}</span>
      <span>Deadline: {formatWorkDate(job.deadline)}</span>
      {job.salaryText && <span>Salary: {job.salaryText}</span>}
    </div>
    {!compact && <WorkJobSource job={job} />}
  </div>
  <a class="work-job-arrow" href={`/work/jobs/${job.slug}/`} aria-label={`View ${job.title}`}>
    <span aria-hidden="true">→</span>
  </a>
</article>
