<section class="cv-builder" aria-labelledby="cv-builder-title">
  <div class="cv-builder-heading">
    <div>
      <p class="work-eyebrow">Free · private · no account</p>
      <h2 id="cv-builder-title">Build your CV</h2>
      <p>Your information stays in this browser. Add each job and qualification as its own entry, then print a clean, text-based CV.</p>
    </div>
    <div class="cv-builder-actions">
      <button class="work-button" type="button" data-cv-download>Download PDF</button>
      <button class="work-button work-button-secondary" type="button" data-cv-print>Print CV</button>
      <button class="work-button work-button-secondary" type="button" data-cv-copy>Copy CV text</button>
      <span class="cv-copy-status" role="status" aria-live="polite"></span>
    </div>
  </div>
  <div class="cv-builder-layout">
    <form class="cv-form" data-cv-form>
      <fieldset>
        <legend>Contact details</legend>
        <label>Full name<input name="name" autocomplete="name" placeholder="e.g. Amina Nakato" /></label>
        <label>Email<input name="email" type="email" autocomplete="email" placeholder="amina@example.com" /></label>
        <label>Phone<input name="phone" type="tel" autocomplete="tel" placeholder="+256 700 000 000" /></label>
        <label>Location<input name="location" autocomplete="address-level2" placeholder="Kampala, Uganda" /></label>
        <label>LinkedIn or portfolio <span class="cv-optional">(optional)</span><input name="website" type="url" placeholder="https://linkedin.com/in/yourname" /></label>
      </fieldset>
      <fieldset>
        <legend>Professional profile</legend>
        <label>Short introduction <span class="cv-optional">(2–4 lines)</span><textarea name="profile" rows="4" placeholder="Summarise your experience, strongest relevant skills and the value you bring to the role."></textarea></label>
        <label>Key skills <span class="cv-optional">(one per line)</span><textarea name="skills" rows="4" placeholder="Customer service&#10;Stock management&#10;Microsoft Excel"></textarea></label>
      </fieldset>
      <fieldset>
        <legend>Work experience</legend>
        <p class="cv-field-help">Add a separate entry for every role. Use the bullet fields for responsibilities and achievements.</p>
        <div class="cv-entry-list" data-entry-list="experience"></div>
        <button class="cv-add-entry" type="button" data-add-entry="experience">+ Add work experience</button>
      </fieldset>
      <fieldset>
        <legend>Education and training</legend>
        <div class="cv-entry-list" data-entry-list="education"></div>
        <button class="cv-add-entry" type="button" data-add-entry="education">+ Add education</button>
      </fieldset>
      <fieldset>
        <legend>Additional information</legend>
        <label>Certifications, languages, projects or relevant volunteering <span class="cv-optional">(optional, one per line)</span><textarea name="additional" rows="4" placeholder="First Aid Certificate | 2024&#10;Languages: English, Luganda"></textarea></label>
      </fieldset>
    </form>
    <article class="cv-preview" aria-label="CV preview" data-cv-preview>
      <header class="cv-preview-header">
        <h2 data-cv-name>Your Name</h2>
        <p data-cv-contact>Add your contact details in the form</p>
      </header>
      <section data-cv-section="profile" hidden><h3>Professional Profile</h3><p data-cv-profile></p></section>
      <section data-cv-section="skills" hidden><h3>Key Skills</h3><ul data-cv-skills></ul></section>
      <section data-cv-section="experience" hidden><h3>Work Experience</h3><div data-cv-experience></div></section>
      <section data-cv-section="education" hidden><h3>Education and Training</h3><div data-cv-education></div></section>
      <section data-cv-section="additional" hidden><h3>Additional Information</h3><ul data-cv-additional></ul></section>
    </article>
  </div>
  <p class="cv-builder-note">Use simple headings and accurate details. Tailor the profile and skills to each vacancy. If an employer requests a Word file, copy the CV text into a document and save it as .docx. Always follow the employer’s file instructions; no layout can guarantee how every applicant system will parse a file.</p>
</section>

<template data-entry-template="experience">
  <div class="cv-entry" data-entry role="group" aria-label="Work experience entry">
    <h3 class="cv-entry-title">Role</h3>
    <button class="cv-remove-entry" type="button" data-remove-entry aria-label="Remove this role">Remove</button>
    <label>Job title<input data-entry-field="title" placeholder="Sales Assistant" /></label>
    <label>Employer<input data-entry-field="organization" placeholder="Example Stores" /></label>
    <label>Location <span class="cv-optional">(optional)</span><input data-entry-field="location" placeholder="Kampala" /></label>
    <div class="cv-date-fields"><label>Start date<input data-entry-field="start" placeholder="Jan 2023" /></label><label>End date<input data-entry-field="end" placeholder="Present" /></label></div>
    <label>Responsibilities and achievements <span class="cv-optional">(one per line)</span><textarea data-entry-field="details" rows="4" placeholder="Helped customers find products and resolve queries&#10;Recorded daily sales and supported stock counts"></textarea></label>
  </div>
</template>
<template data-entry-template="education">
  <div class="cv-entry" data-entry role="group" aria-label="Education entry">
    <h3 class="cv-entry-title">Qualification</h3>
    <button class="cv-remove-entry" type="button" data-remove-entry aria-label="Remove this qualification">Remove</button>
    <label>Qualification or course<input data-entry-field="title" placeholder="Diploma in Business Administration" /></label>
    <label>Institution<input data-entry-field="organization" placeholder="Example Institute" /></label>
    <div class="cv-date-fields"><label>Start date <span class="cv-optional">(optional)</span><input data-entry-field="start" placeholder="2021" /></label><label>End date or completion year<input data-entry-field="end" placeholder="2023" /></label></div>
    <label>Relevant details <span class="cv-optional">(optional)</span><textarea data-entry-field="details" rows="2" placeholder="Relevant subjects, honours or project"></textarea></label>
  </div>
</template>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-cv-form]');
  const preview = document.querySelector<HTMLElement>('[data-cv-preview]');

  if (form && preview) {
    const value = (name: string) => String(new FormData(form).get(name) ?? '').trim();
    const lines = (input: string) => input.split('\n').map((line) => line.trim()).filter(Boolean);
    const entryValues = (type: string) => Array.from(form.querySelectorAll<HTMLElement>(`[data-entry-list="${type}"] [data-entry]`)).map((entry) => {
      const get = (field: string) => entry.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-entry-field="${field}"]`)?.value.trim() ?? '';
      return { title: get('title'), organization: get('organization'), location: get('location'), start: get('start'), end: get('end'), details: lines(get('details')) };
    }).filter((entry) => entry.title || entry.organization || entry.details.length);
    const textElement = (tag: string, text: string, className = '') => {
      const element = document.createElement(tag);
      element.textContent = text;
      if (className) element.className = className;
      return element;
    };
    const renderEntries = (type: string, selector: string) => {
      const target = preview.querySelector<HTMLElement>(selector)!;
      const entries = entryValues(type);
      target.replaceChildren(...entries.map((entry) => {
        const block = document.createElement('div');
        block.className = 'cv-preview-entry';
        if (entry.title) block.append(textElement('h4', entry.title));
        const meta = [entry.organization, entry.location, [entry.start, entry.end].filter(Boolean).join(' – ')].filter(Boolean).join(' | ');
        if (meta) block.append(textElement('p', meta, 'cv-preview-meta'));
        if (entry.details.length) {
          const list = document.createElement('ul');
          for (const detail of entry.details) list.append(textElement('li', detail));
          block.append(list);
        }
        return block;
      }));
      preview.querySelector(`[data-cv-section="${type}"]`)!.toggleAttribute('hidden', entries.length === 0);
    };
    const renderList = (type: string, selector: string) => {
      const target = preview.querySelector<HTMLElement>(selector)!;
      const entries = lines(value(type));
      target.replaceChildren(...entries.map((entry) => textElement('li', entry)));
      preview.querySelector(`[data-cv-section="${type}"]`)!.toggleAttribute('hidden', entries.length === 0);
    };
    const render = () => {
      preview.querySelector('[data-cv-name]')!.textContent = value('name') || 'Your Name';
      const contact = [value('email'), value('phone'), value('location'), value('website')].filter(Boolean);
      preview.querySelector('[data-cv-contact]')!.textContent = contact.join(' · ') || 'Add your contact details in the form';
      const profile = value('profile');
      preview.querySelector('[data-cv-profile]')!.textContent = profile;
      preview.querySelector('[data-cv-section="profile"]')!.toggleAttribute('hidden', !profile);
      renderList('skills', '[data-cv-skills]');
      renderEntries('experience', '[data-cv-experience]');
      renderEntries('education', '[data-cv-education]');
      renderList('additional', '[data-cv-additional]');
    };
    const downloadPdf = async () => {
      const status = document.querySelector<HTMLElement>('.cv-copy-status');
      if (status) status.textContent = 'Preparing your PDF…';
      try {
        const { jsPDF } = await import('jspdf');
        const pdf = new jsPDF({ unit: 'mm', format: 'a4', compress: true });
        const pageWidth = pdf.internal.pageSize.getWidth();
        const pageHeight = pdf.internal.pageSize.getHeight();
        const margin = 17;
        const contentWidth = pageWidth - margin * 2;
        const bottom = pageHeight - margin;
        const navy = [24, 59, 104] as const;
        const dark = [24, 36, 51] as const;
        const muted = [83, 101, 123] as const;
        const safeText = (text: string) => text
          .replace(/[‘’]/g, "'")
          .replace(/[“”]/g, '"')
          .replace(/[–—]/g, '-')
          .replace(/…/g, '...')
          .replace(/[^\x20-\xFF]/g, '?');
        let y = margin;
        const name = value('name') || 'Your Name';
        const newPage = () => {
          pdf.addPage();
          y = margin;
          pdf.setFont('helvetica', 'bold');
          pdf.setFontSize(12);
          pdf.setTextColor(...navy);
          pdf.text(safeText(name), margin, y);
          y += 5;
          pdf.setDrawColor(...navy);
          pdf.setLineWidth(0.4);
          pdf.line(margin, y, pageWidth - margin, y);
          y += 7;
        };
        const writeLines = (text: string, x: number, width: number, fontSize: number, leading: number, style: 'normal' | 'bold' = 'normal', color: readonly [number, number, number] = dark) => {
          pdf.setFont('helvetica', style);
          pdf.setFontSize(fontSize);
          pdf.setTextColor(...color);
          const wrapped = pdf.splitTextToSize(safeText(text), width) as string[];
          for (const line of wrapped) {
            if (y + leading > bottom) newPage();
            pdf.text(line, x, y);
            y += leading;
          }
        };
        const sectionHeading = (heading: string) => {
          if (y + 13 > bottom) newPage();
          y += 4;
          pdf.setFont('helvetica', 'bold');
          pdf.setFontSize(12);
          pdf.setTextColor(...navy);
          pdf.text(heading.toUpperCase(), margin, y);
          y += 2;
          pdf.setDrawColor(174, 189, 206);
          pdf.setLineWidth(0.25);
          pdf.line(margin, y, pageWidth - margin, y);
          y += 5;
        };
        const writeBullets = (items: string[]) => {
          for (const item of items) writeLines(`- ${item}`, margin + 3, contentWidth - 3, 10.8, 5.3);
        };

        pdf.setProperties({ title: `${name} - CV`, subject: 'Curriculum vitae', creator: 'SSEGU CV Builder' });
        pdf.setFont('helvetica', 'bold');
        pdf.setFontSize(20.5);
        pdf.setTextColor(...navy);
        const nameLines = pdf.splitTextToSize(safeText(name), contentWidth) as string[];
        for (const line of nameLines) {
          if (y + 10 > bottom) newPage();
          pdf.text(line, margin, y);
          y += 9;
        }
        const contact = [value('email'), value('phone'), value('location'), value('website')].filter(Boolean).join(' | ');
        if (contact) writeLines(contact, margin, contentWidth, 10.5, 4.8, 'normal', muted);
        y += 2;
        pdf.setDrawColor(...navy);
        pdf.setLineWidth(0.65);
        pdf.line(margin, y, pageWidth - margin, y);
        y += 4;

        const profile = value('profile');
        if (profile) {
          sectionHeading('Professional Profile');
          writeLines(profile, margin, contentWidth, 10.8, 5.3);
        }
        const skills = lines(value('skills'));
        if (skills.length) {
          sectionHeading('Key Skills');
          writeBullets(skills);
        }
        const experiences = entryValues('experience');
        if (experiences.length) {
          sectionHeading('Work Experience');
          for (const entry of experiences) {
            if (entry.title) writeLines(entry.title, margin, contentWidth, 11.5, 5, 'bold');
            const meta = [entry.organization, entry.location, [entry.start, entry.end].filter(Boolean).join(' - ')].filter(Boolean).join(' | ');
            if (meta) writeLines(meta, margin, contentWidth, 10.8, 5, 'normal', muted);
            writeBullets(entry.details);
            y += 2;
          }
        }
        const education = entryValues('education');
        if (education.length) {
          sectionHeading('Education and Training');
          for (const entry of education) {
            if (entry.title) writeLines(entry.title, margin, contentWidth, 11.5, 5, 'bold');
            const meta = [entry.organization, entry.location, [entry.start, entry.end].filter(Boolean).join(' - ')].filter(Boolean).join(' | ');
            if (meta) writeLines(meta, margin, contentWidth, 10.8, 5, 'normal', muted);
            writeBullets(entry.details);
            y += 2;
          }
        }
        const additional = lines(value('additional'));
        if (additional.length) {
          sectionHeading('Additional Information');
          writeBullets(additional);
        }
        const filename = name.normalize('NFKD').replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '-') || 'CV';
        pdf.save(`${filename}-CV.pdf`);
        if (status) status.textContent = 'Your PDF download has started.';
      } catch {
        if (status) status.textContent = 'PDF download failed. Use Print CV and choose Save as PDF instead.';
      }
    };
    const addEntry = (type: string) => {
      const template = document.querySelector<HTMLTemplateElement>(`[data-entry-template="${type}"]`);
      const list = form.querySelector<HTMLElement>(`[data-entry-list="${type}"]`);
      if (!template || !list) return;
      list.append(template.content.cloneNode(true));
      render();
    };
    addEntry('experience');
    addEntry('education');
    form.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const add = target.closest<HTMLButtonElement>('[data-add-entry]');
      if (add) addEntry(add.dataset.addEntry!);
      const remove = target.closest<HTMLButtonElement>('[data-remove-entry]');
      if (remove) {
        remove.closest('[data-entry]')?.remove();
        render();
      }
    });
    const printStyles = `body{margin:0;color:#182433;font:10.8pt Arial,Helvetica,sans-serif;line-height:1.5} .cv-preview{max-width:190mm;margin:0 auto} .cv-preview-header{padding-bottom:10pt;border-bottom:2px solid #183b68} .cv-preview-header h2{margin:0 0 5pt;color:#122e50;font-size:20.5pt} .cv-preview-header p{margin:0;font-size:10.5pt} .cv-preview section{margin-top:13pt} .cv-preview section h3{margin:0 0 6pt;padding-bottom:3pt;border-bottom:1px solid #aebdce;color:#183b68;font-size:12pt;text-transform:uppercase;letter-spacing:.03em} .cv-preview-entry{margin:0 0 10pt} .cv-preview-entry h4{margin:0;font-size:11.5pt} .cv-preview p,.cv-preview li{margin:2pt 0;font-size:10.8pt;overflow-wrap:anywhere} .cv-preview ul{margin:3pt 0 0;padding-left:12pt;list-style:none} .cv-preview li{padding-left:10pt;text-indent:-10pt} .cv-preview li:before{content:'- '} .cv-preview-meta{color:#53657b} @page{size:A4;margin:16mm}`;
    const printCv = () => {
      const printWindow = window.open('', '_blank');
      if (!printWindow) {
        document.querySelector<HTMLElement>('.cv-copy-status')!.textContent = 'Allow pop-ups for this site to print or save your CV.';
        return;
      }
      const clone = preview.cloneNode(true) as HTMLElement;
      clone.removeAttribute('data-cv-preview');
      const title = value('name') ? `${value('name')} - CV` : 'CV';
      printWindow.onload = () => { printWindow.focus(); printWindow.print(); };
      printWindow.document.open();
      printWindow.document.write(`<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${title.replace(/[<>&"']/g, '')}</title><style>${printStyles}</style></head><body>${clone.outerHTML}</body></html>`);
      printWindow.document.close();
    };
    form.addEventListener('input', render);
    render();
    document.querySelector('[data-cv-download]')?.addEventListener('click', downloadPdf);
    document.querySelector('[data-cv-print]')?.addEventListener('click', printCv);
    document.querySelector('[data-cv-copy]')?.addEventListener('click', async () => {
      const text = preview.innerText.replace(/\n{3,}/g, '\n\n').trim();
      const status = document.querySelector<HTMLElement>('.cv-copy-status');
      try {
        await navigator.clipboard.writeText(text);
        if (status) status.textContent = 'CV text copied.';
      } catch {
        if (status) status.textContent = 'Copy is unavailable here. Select the preview text and copy it.';
      }
    });
  }
</script>

<style>
  .cv-builder { margin: 2rem 0; padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--work-line); border-radius: var(--work-radius); background: #f8fbff; }
  .cv-builder-heading { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: 1.5rem; }
  .cv-builder-heading h2 { margin: 0 0 .5rem; color: var(--work-navy); }
  .cv-builder-heading p:not(.work-eyebrow) { max-width: 650px; margin: 0; }
  .cv-builder-actions { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
  .cv-copy-status { flex-basis: 100%; font-size: .85rem; }
  .cv-builder-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .9fr); align-items: start; gap: 1.25rem; }
  .cv-form { display: grid; gap: 1rem; }
  .cv-form fieldset { min-width: 0; display: grid; gap: .8rem; margin: 0; padding: 1rem; border: 1px solid var(--work-line); border-radius: 10px; background: white; }
  .cv-form legend { padding: 0 .35rem; color: var(--work-navy); font-weight: 800; }
  .cv-form label { display: grid; gap: .35rem; font-size: .9rem; font-weight: 700; }
  .cv-form input, .cv-form textarea { width: 100%; padding: .7rem .75rem; border: 1px solid #b8c6d9; border-radius: 6px; color: #14243a; font: inherit; font-weight: 400; }
  .cv-form textarea { resize: vertical; }
  .cv-optional, .cv-field-help { color: #53657b; font-size: .82rem; font-weight: 400; }
  .cv-field-help { margin: -.3rem 0 0; }
  .cv-entry { position: relative; display: grid; gap: .7rem; margin: 0; padding: 1rem; border: 1px solid #d7e0eb; border-radius: 8px; }
  .cv-entry-title { margin: 0; color: var(--work-navy); font-size: .9rem; }
  .cv-entry .cv-remove-entry { position: absolute; top: .35rem; right: .5rem; padding: .25rem .4rem; border: 0; background: transparent; color: #8b2932; cursor: pointer; }
  .cv-date-fields { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
  .cv-add-entry { justify-self: start; padding: .45rem .7rem; border: 1px solid var(--work-blue); border-radius: 5px; background: white; color: var(--work-blue); font: inherit; font-weight: 700; cursor: pointer; }
  .cv-preview { position: sticky; top: 1rem; align-self: start; max-height: calc(100vh - 2rem); max-height: calc(100svh - 2rem); min-height: 430px; overflow-y: auto; scrollbar-width: thin; padding: clamp(1.1rem, 3vw, 2rem); background: white; border: 1px solid var(--work-line); box-shadow: 0 4px 18px rgb(8 47 120 / 8%); color: #182433; font-family: Arial, Helvetica, sans-serif; }
  .cv-preview-header { padding-bottom: .8rem; border-bottom: 2px solid #183b68; }
  .cv-preview-header h2 { margin: 0 0 .4rem; color: #122e50; font-size: 1.7rem; }
  .cv-preview-header p { margin: 0; overflow-wrap: anywhere; font-size: .88rem; }
  .cv-preview section { margin-top: 1.1rem; }
  .cv-preview section h3 { margin: 0 0 .45rem; padding-bottom: .25rem; border-bottom: 1px solid #aebdce; color: #183b68; font-size: .96rem; text-transform: uppercase; letter-spacing: .035em; }
  .cv-preview h4 { margin: .6rem 0 .15rem; color: #182433; font-size: .92rem; }
  .cv-preview p, .cv-preview li { font-size: .9rem; line-height: 1.5; overflow-wrap: anywhere; }
  .cv-preview p { margin: .25rem 0; white-space: pre-wrap; }
  .cv-preview-meta { color: #53657b; }
  .cv-preview ul { margin: .3rem 0 0; padding-left: .9rem; list-style: none; }
  .cv-preview li { padding-left: .8rem; text-indent: -.8rem; }
  .cv-preview li::before { content: "- "; }
  .cv-preview :global(.cv-preview-entry) { margin: .7rem 0 1rem; }
  .cv-preview :global(.cv-preview-entry h4) { margin: .6rem 0 .15rem; color: #182433; font-size: .92rem; line-height: 1.3; }
  .cv-preview :global(.cv-preview-entry p),
  .cv-preview :global(.cv-preview-entry li) { font-size: .9rem; line-height: 1.5; overflow-wrap: anywhere; }
  .cv-preview :global(.cv-preview-entry p) { margin: .25rem 0; white-space: pre-wrap; }
  .cv-preview :global(.cv-preview-entry .cv-preview-meta) { color: #53657b; }
  .cv-preview :global(ul) { margin: .3rem 0 0; padding-left: .9rem; list-style: none; }
  .cv-preview :global(li) { padding-left: .8rem; text-indent: -.8rem; font-size: .9rem; line-height: 1.5; overflow-wrap: anywhere; }
  .cv-preview :global(li::before) { content: "- "; }
  .cv-builder-note { margin: 1rem 0 0; color: #53657b; font-size: .9rem; }
  @media (max-width: 850px) { .cv-builder-heading { align-items: start; flex-direction: column; } .cv-builder-layout { grid-template-columns: 1fr; } .cv-preview { position: static; max-height: none; overflow: visible; } }
</style>
