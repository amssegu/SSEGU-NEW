---
import WorkCourseCard from './WorkCourseCard.astro';
import WorkLayout from '../../layouts/WorkLayout.astro';
import AdSlot from '../main/AdSlot.astro';
import { courseStatusLabel, isSafeCourseUrl } from '../../lib/work';
import type { WorkCourse } from '../../lib/work';

interface Props {
  courses: WorkCourse[];
  allCourses: WorkCourse[];
  options: {
    providers: string[];
    subjects: string[];
    levels: string[];
    coursePrices: string[];
    certificatePrices: string[];
    deliveryModes: string[];
  };
  page: number;
  pageCount: number;
  total: number;
}

const { courses, allCourses, options, page, pageCount, total } = Astro.props;
const filterOptions = (values: string[]) => values.filter(Boolean);
const start = total === 0 ? 0 : (page - 1) * 48 + 1;
const end = Math.min(page * 48, total);
const previousHref = page === 2 ? '/work/courses/' : `/work/courses/page/${page - 1}/`;
const nextHref = `/work/courses/page/${page + 1}/`;
const clientCourses = allCourses.map((course) => ({
  ...course,
  providerUrl: isSafeCourseUrl(course.sourceUrl) ? course.sourceUrl : '',
}));
---

<WorkLayout
  title="Courses | SSEGU Work"
  description="Browse factual, link-only course listings from selected learning providers."
  noindex={Astro.url.search.length > 0}
>
  <div class="work-page-shell">
    <div class="work-page-intro">
      <p class="work-eyebrow">Build useful skills</p>
      <h1>Courses</h1>
      <p>
        Compare practical learning options, then continue to the original provider to study. SSEGU
        does not host the courses or claim affiliation with the providers listed.
      </p>
    </div>
    <form id="work-course-filters" class="work-filter-panel" data-testid="work-course-filters">
      <div class="work-filter-grid">
        <div>
          <label for="course-search">Search courses</label>
          <input
            id="course-search"
            name="q"
            type="search"
            placeholder="Title or provider"
            autocomplete="off"
          />
        </div>
        <div>
          <label for="course-provider">Provider</label>
          <select id="course-provider" name="provider">
            <option value="">All providers</option>
            {filterOptions(options.providers).map((value) => (
              <option value={value}>{value}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="course-subject">Subject</label>
          <select id="course-subject" name="subject">
            <option value="">All subjects</option>
            {filterOptions(options.subjects).map((value) => (
              <option value={value}>{value}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="course-level">Level</label>
          <select id="course-level" name="level">
            <option value="">All levels</option>
            {filterOptions(options.levels).map((value) => (
              <option value={value}>{value}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="course-price">Course price</label>
          <select id="course-price" name="price">
            <option value="">Any course price</option>
            {filterOptions(options.coursePrices).map((value) => (
              <option value={value}>{courseStatusLabel(value)}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="certificate-price">Certificate price</label>
          <select id="certificate-price" name="certificatePrice">
            <option value="">Any certificate price</option>
            {filterOptions(options.certificatePrices).map((value) => (
              <option value={value}>{courseStatusLabel(value)}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="course-delivery">Delivery</label>
          <select id="course-delivery" name="delivery">
            <option value="">Any delivery mode</option>
            {filterOptions(options.deliveryModes).map((value) => (
              <option value={value}>{courseStatusLabel(value)}</option>
            ))}
          </select>
        </div>
      </div>
      <div class="work-filter-actions">
        <button class="work-button" type="submit">
          Search courses
        </button>
        <button class="work-button work-button-secondary" type="reset">
          Clear
        </button>
      </div>
    </form>
    <p id="course-results-status" class="work-results-status" role="status" aria-live="polite">
      Showing {start}–{end} of {total} courses.
    </p>
    <div class="work-resource-grid" data-course-results>
      {courses.map((course) => (
        <WorkCourseCard course={course} />
      ))}
    </div>
    <p class="work-course-empty" data-course-empty hidden>
      No courses match those filters.
    </p>
    <nav
      id="course-pagination"
      class="work-filter-actions work-pagination"
      aria-label="Course pages"
    >
      {page > 1 && (
        <a class="work-button work-button-secondary" href={previousHref}>
          Previous page
        </a>
      )}
      <span>
        Page {page} of {pageCount}
      </span>
      {page < pageCount && (
        <a class="work-button" href={nextHref}>
          Next page
        </a>
      )}
    </nav>
    <AdSlot placement="section" format="horizontal" />
  </div>
</WorkLayout>

<script is:inline define:vars={{ courses: clientCourses, initialPage: page }}>
  const form = document.querySelector('#work-course-filters');
  const results = document.querySelector('[data-course-results]');
  const status = document.querySelector('#course-results-status');
  const empty = document.querySelector('[data-course-empty]');
  const pagination = document.querySelector('#course-pagination');
  const params = new URLSearchParams(window.location.search);
  const fields = ['q', 'provider', 'subject', 'level', 'price', 'certificatePrice', 'delivery'];
  const pageSize = 48;
  let currentPage = Number(params.get('page')) || initialPage || 1;
  fields.forEach((name) => {
    const input = form?.elements.namedItem(name);
    if (input && params.has(name)) input.value = params.get(name);
  });
  const escapeHtml = (value) =>
    String(value ?? '').replace(
      /[&<>"']/g,
      (character) =>
        ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        })[character],
    );
  const label = (value) =>
    String(value || 'Unknown')
      .replace(/_/g, ' ')
      .replace(/\b\w/g, (letter) => letter.toUpperCase());
  const renderCourse = (course) => {
    const metadata = [course.subject, course.level, course.duration, course.language].filter(
      Boolean,
    );
    return `<article class="work-resource-card" data-course-card>
      <span class="work-resource-icon" aria-hidden="true">◆</span>
      <p class="work-card-kicker">${escapeHtml(course.format)}</p>
      <h2><a href="/work/courses/${escapeHtml(course.slug)}/">${escapeHtml(course.title)}</a></h2>
      <p class="work-resource-provider">${escapeHtml(course.provider)}</p>
      <p class="work-course-summary">${escapeHtml(course.description)}</p>
      ${metadata.length ? `<p class="work-resource-meta">${metadata.map(escapeHtml).join(' · ')}</p>` : ''}
      <div class="work-course-facts">
        <span><strong>Course</strong>${escapeHtml(label(course.coursePriceStatus))}</span>
        <span><strong>Certificate</strong>${escapeHtml(label(course.certificatePriceStatus))}</span>
        ${course.deliveryMode ? `<span><strong>Delivery</strong>${escapeHtml(label(course.deliveryMode))}</span>` : ''}
      </div>
      <div class="work-resource-card-actions">
        <a class="work-text-link" href="/work/courses/${escapeHtml(course.slug)}/">Course details →</a>
        ${course.providerUrl ? `<a class="work-text-link" href="${escapeHtml(course.providerUrl)}" target="_blank" rel="noopener noreferrer">Visit provider ↗</a>` : ''}
      </div>
    </article>`;
  };
  const apply = (updateUrl = true) => {
    const data = new FormData(form);
    const query = String(data.get('q') || '')
      .toLowerCase()
      .trim();
    const matches = courses.filter((course) => {
      const text = [
        course.title,
        course.provider,
        course.description,
        course.subject,
        course.level,
        course.format,
      ]
        .join(' ')
        .toLowerCase();
      return (
        (!query || text.includes(query)) &&
        (!data.get('provider') || course.provider === data.get('provider')) &&
        (!data.get('subject') || course.subject === data.get('subject')) &&
        (!data.get('level') || course.level === data.get('level')) &&
        (!data.get('price') || course.coursePriceStatus === data.get('price')) &&
        (!data.get('certificatePrice') ||
          course.certificatePriceStatus === data.get('certificatePrice')) &&
        (!data.get('delivery') || course.deliveryMode === data.get('delivery'))
      );
    });
    const pageCount = Math.max(1, Math.ceil(matches.length / pageSize));
    currentPage = Math.min(currentPage, pageCount);
    const visible = matches.slice((currentPage - 1) * pageSize, currentPage * pageSize);
    if (results) results.innerHTML = visible.map(renderCourse).join('');
    if (status)
      status.textContent = matches.length
        ? `Showing ${(currentPage - 1) * pageSize + 1}–${Math.min(currentPage * pageSize, matches.length)} of ${matches.length} courses.`
        : 'No courses match those filters.';
    if (empty) empty.hidden = matches.length > 0;
    if (pagination)
      pagination.innerHTML = `${currentPage > 1 ? `<a class="work-button work-button-secondary" href="#" data-page="${currentPage - 1}">Previous page</a>` : ''}<span>Page ${currentPage} of ${pageCount}</span>${currentPage < pageCount ? `<a class="work-button" href="#" data-page="${currentPage + 1}">Next page</a>` : ''}`;
    if (updateUrl) {
      const next = new URLSearchParams();
      fields.forEach((name) => {
        const value = String(data.get(name) || '').trim();
        if (value) next.set(name, value);
      });
      if (currentPage > 1) next.set('page', String(currentPage));
      history.replaceState(null, '', `/work/courses/${next.size ? `?${next}` : ''}`);
    }
  };
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    currentPage = 1;
    apply();
  });
  form?.addEventListener('reset', () => {
    currentPage = 1;
    setTimeout(() => apply());
  });
  fields.forEach((name) =>
    form?.elements.namedItem(name)?.addEventListener('change', () => {
      currentPage = 1;
      apply();
    }),
  );
  form?.elements.namedItem('q')?.addEventListener('input', () => {
    currentPage = 1;
    apply();
  });
  pagination?.addEventListener('click', (event) => {
    const link = event.target.closest('[data-page]');
    if (!link) return;
    event.preventDefault();
    currentPage = Number(link.dataset.page) || 1;
    apply();
    results?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  apply(false);
</script>
