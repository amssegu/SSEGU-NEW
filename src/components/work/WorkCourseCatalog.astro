---
import WorkCourseCard from './WorkCourseCard.astro';
import WorkLayout from '../../layouts/WorkLayout.astro';
import AdSlot from '../main/AdSlot.astro';
import { courseStatusLabel, isSafeCourseUrl } from '../../lib/work';
import type { WorkCourse } from '../../lib/work';

interface Props {
  courses: WorkCourse[];
  allCourses: WorkCourse[];
  options: {
    providers: string[];
    categories: string[];
    credentials: string[];
    subjects: string[];
    levels: string[];
    coursePrices: string[];
    certificatePrices: string[];
    deliveryModes: string[];
  };
  page: number;
  pageCount: number;
  total: number;
}

const { courses, allCourses, options, page, pageCount, total } = Astro.props;
const filterOptions = (values: string[]) => values.filter(Boolean);
const pageSize = 9;
const start = total === 0 ? 0 : (page - 1) * pageSize + 1;
const end = Math.min(page * pageSize, total);
const previousHref = page === 2 ? '/work/courses/' : `/work/courses/page/${page - 1}/`;
const nextHref = `/work/courses/page/${page + 1}/`;
const clientCourses = allCourses.map((course) => ({
  ...course,
  providerUrl: isSafeCourseUrl(course.sourceUrl) ? course.sourceUrl : '',
}));
---

<WorkLayout
  title="Courses | SSEGU Work"
  description="Browse 50 editorially approved courses and check access, evidence and outstanding provider details before enrolling."
  noindex={Astro.url.search.length > 0}
>
  <div class="work-page-shell">
    <div class="work-page-intro">
      <p class="work-eyebrow">Build useful skills</p>
      <h1>Courses</h1>
      <nav class="work-filter-actions" aria-label="Course catalogue sections">
        <a class="work-button work-button-secondary" href="/work/courses/categories/">Browse categories</a>
        <a class="work-button work-button-secondary" href="/work/courses/free/">Free courses</a>
        <a class="work-button work-button-secondary" href="/work/career-pathways/">Career pathways</a>
        <a class="work-button work-button-secondary" href="/work/courses/how-we-evaluate/">How we evaluate</a>
      </nav>
    </div>
    <div class="work-courses-layout">
      <main class="work-courses-main">
        <form id="work-course-filters" class="work-filter-panel work-course-filter-panel" data-testid="work-course-filters">
          <div class="work-course-filter-toolbar">
            <label class="sr-only" for="course-search">Search courses</label>
            <input
              id="course-search"
              name="q"
              type="search"
              placeholder="Search courses or providers"
              autocomplete="off"
            />
            <button
              class="work-button work-button-secondary"
              id="toggle-course-filters"
              type="button"
              aria-expanded="false"
              aria-controls="course-advanced-filters"
            >
              More filters <span aria-hidden="true">⌄</span>
            </button>
          </div>
          <div class="work-course-advanced-filters" id="course-advanced-filters" hidden>
            <div class="work-filter-grid">
              <div>
                <label for="course-provider">Provider</label>
                <select id="course-provider" name="provider">
                  <option value="">All providers</option>
                  {filterOptions(options.providers).map((value) => (
                    <option value={value}>{value}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="course-category">Category</label>
                <select id="course-category" name="category">
                  <option value="">All categories</option>
                  {filterOptions(options.categories).map((value) => (
                    <option value={value}>{value}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="course-credential">Credential type</label>
                <select id="course-credential" name="credential">
                  <option value="">Any credential</option>
                  {filterOptions(options.credentials).map((value) => (
                    <option value={value}>{value}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="course-level">Level</label>
                <select id="course-level" name="level">
                  <option value="">All levels</option>
                  {filterOptions(options.levels).map((value) => (
                    <option value={value}>{value}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="course-price">Course price</label>
                <select id="course-price" name="price">
                  <option value="">Any course price</option>
                  {filterOptions(options.coursePrices).map((value) => (
                    <option value={value}>{courseStatusLabel(value)}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="certificate-price">Certificate price</label>
                <select id="certificate-price" name="certificatePrice">
                  <option value="">Any certificate price</option>
                  {filterOptions(options.certificatePrices).map((value) => (
                    <option value={value}>{courseStatusLabel(value)}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="course-delivery">Delivery</label>
                <select id="course-delivery" name="delivery">
                  <option value="">Any delivery mode</option>
                  {filterOptions(options.deliveryModes).map((value) => (
                    <option value={value}>{courseStatusLabel(value)}</option>
                  ))}
                </select>
              </div>
            </div>
            <div class="work-filter-actions">
              <button class="work-button" type="submit">Apply filters</button>
              <button class="work-button work-button-secondary" type="reset">Clear all</button>
            </div>
          </div>
        </form>
        <p id="course-results-status" class="work-results-status" role="status" aria-live="polite">
          Showing {start}–{end} of {total} courses.
        </p>
        <div class="work-resource-grid work-course-results-grid" data-course-results>
          {courses.map((course) => (
            <WorkCourseCard course={course} />
          ))}
        </div>
        <p class="work-course-empty" data-course-empty hidden={allCourses.length > 0}>
          {allCourses.length
            ? 'No courses match those filters. Try changing your search.'
            : 'We’re connecting direct course catalogs. Courses will appear here once source details are available.'}
        </p>
        <nav
          id="course-pagination"
          class="work-filter-actions work-pagination"
          aria-label="Course pages"
        >
          {page > 1 && (
            <a class="work-button work-button-secondary" href={previousHref}>
              Previous page
            </a>
          )}
          <span>
            Page {page} of {pageCount}
          </span>
          {page < pageCount && (
            <a class="work-button" href={nextHref}>
              Next page
            </a>
          )}
        </nav>
      </main>
      <aside class="work-courses-aside" aria-label="Course learning resources">
        <AdSlot placement="sidebar" format="rectangle" minHeight={280} />
        <section class="work-jobs-aside-panel">
          <p class="work-eyebrow">Plan your learning</p>
          <h2>Choose a course with confidence</h2>
          <p>Check the provider’s current fees, certificate terms and availability in Uganda before you enrol.</p>
          <ul>
            <li>Compare free access with paid certificates.</li>
            <li>Look for a level and format that fit your schedule.</li>
            <li>Confirm all details on the provider’s own site.</li>
          </ul>
          <a href="/work/courses/free/">Browse free courses <span aria-hidden="true">→</span></a>
          <a href="/work/career-pathways/">Explore career pathways <span aria-hidden="true">→</span></a>
          <a href="/work/courses/how-we-evaluate/">How we evaluate courses <span aria-hidden="true">→</span></a>
        </section>
      </aside>
    </div>
  </div>
</WorkLayout>

<script is:inline define:vars={{ courses: clientCourses, initialPage: page }}>
  const form = document.querySelector('#work-course-filters');
  const results = document.querySelector('[data-course-results]');
  const status = document.querySelector('#course-results-status');
  const empty = document.querySelector('[data-course-empty]');
  const pagination = document.querySelector('#course-pagination');
  const filterToggle = document.querySelector('#toggle-course-filters');
  const advancedFilters = document.querySelector('#course-advanced-filters');
  const params = new URLSearchParams(window.location.search);
  const fields = ['q', 'provider', 'category', 'credential', 'level', 'price', 'certificatePrice', 'delivery'];
  const pageSize = 9;
  let currentPage = Number(params.get('page')) || initialPage || 1;
  fields.forEach((name) => {
    const input = form?.elements.namedItem(name);
    if (input && params.has(name)) input.value = params.get(name);
  });
  if (fields.slice(1).some((name) => params.has(name))) {
    advancedFilters.hidden = false;
    filterToggle.setAttribute('aria-expanded', 'true');
    filterToggle.innerHTML = 'Fewer filters <span aria-hidden="true">⌃</span>';
  }
  const escapeHtml = (value) =>
    String(value ?? '').replace(
      /[&<>"']/g,
      (character) =>
        ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        })[character],
    );
  const label = (value) =>
    String(value || 'Unknown')
      .replace(/_/g, ' ')
      .replace(/\b\w/g, (letter) => letter.toUpperCase());
  const renderCourse = (course) => {
    const metadata = [course.level, course.duration, course.deliveryMode].filter(Boolean);
    const category = course.category || course.subject || course.format;
    return `<article class="work-resource-card work-course-card" data-course-card>
      <div class="work-course-card-topline"><p class="work-card-kicker">${escapeHtml(category)}</p><span class="work-course-format">${escapeHtml(course.format)}</span></div>
      <h2 class="work-course-title"><a href="/work/courses/${escapeHtml(course.slug)}/">${escapeHtml(course.title)}</a></h2>
      <p class="work-resource-provider">${escapeHtml(course.provider)}</p>
      <p class="work-course-description">${escapeHtml(course.description)}</p>
      ${metadata.length ? `<p class="work-course-details">${metadata.map(escapeHtml).join(' · ')}</p>` : ''}
      <div class="work-course-facts">
        <span><strong>Course</strong>${escapeHtml(label(course.coursePriceStatus))}</span>
        <span><strong>Credential</strong>${escapeHtml(course.credentialType || label(course.certificatePriceStatus))}</span>
      </div>
      <div class="work-resource-card-actions">
        <a class="work-course-primary-action" href="/work/courses/${escapeHtml(course.slug)}/">View course details <span aria-hidden="true">→</span></a>
        ${course.providerUrl ? `<a class="work-course-provider-link" href="${escapeHtml(course.providerUrl)}" target="_blank" rel="noopener noreferrer">Visit provider <span aria-hidden="true">↗</span></a>` : ''}
      </div>
    </article>`;
  };
  const apply = (updateUrl = true) => {
    const data = new FormData(form);
    const query = String(data.get('q') || '')
      .toLowerCase()
      .trim();
    const matches = courses.filter((course) => {
      const text = [
        course.title,
        course.provider,
        course.description,
        course.subject,
        course.category,
        ...(course.skills || []),
        ...(course.careerRoles || []),
        course.level,
        course.format,
      ]
        .join(' ')
        .toLowerCase();
      return (
        (!query || text.includes(query)) &&
        (!data.get('provider') || course.provider === data.get('provider')) &&
        (!data.get('category') || (course.category || course.subject) === data.get('category')) &&
        (!data.get('credential') || course.credentialType === data.get('credential')) &&
        (!data.get('level') || course.level === data.get('level')) &&
        (!data.get('price') || course.coursePriceStatus === data.get('price')) &&
        (!data.get('certificatePrice') ||
          course.certificatePriceStatus === data.get('certificatePrice')) &&
        (!data.get('delivery') || course.deliveryMode === data.get('delivery'))
      );
    });
    const pageCount = Math.max(1, Math.ceil(matches.length / pageSize));
    currentPage = Math.min(currentPage, pageCount);
    const visible = matches.slice((currentPage - 1) * pageSize, currentPage * pageSize);
    if (results) results.innerHTML = visible.map(renderCourse).join('');
    if (status)
      status.textContent = matches.length
        ? `Showing ${(currentPage - 1) * pageSize + 1}–${Math.min(currentPage * pageSize, matches.length)} of ${matches.length} courses.`
        : courses.length
          ? 'No courses match those filters. Try changing your search.'
          : 'We’re connecting direct course catalogs. Courses will appear here once source details are available.';
    if (empty) empty.hidden = matches.length > 0;
    if (pagination)
      pagination.innerHTML = `${currentPage > 1 ? `<a class="work-button work-button-secondary" href="#" data-page="${currentPage - 1}">Previous page</a>` : ''}<span>Page ${currentPage} of ${pageCount}</span>${currentPage < pageCount ? `<a class="work-button" href="#" data-page="${currentPage + 1}">Next page</a>` : ''}`;
    if (updateUrl) {
      const next = new URLSearchParams();
      fields.forEach((name) => {
        const value = String(data.get(name) || '').trim();
        if (value) next.set(name, value);
      });
      if (currentPage > 1) next.set('page', String(currentPage));
      history.replaceState(null, '', `/work/courses/${next.size ? `?${next}` : ''}`);
    }
  };
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    currentPage = 1;
    apply();
  });
  filterToggle?.addEventListener('click', () => {
    const expanded = filterToggle.getAttribute('aria-expanded') === 'true';
    filterToggle.setAttribute('aria-expanded', String(!expanded));
    advancedFilters.hidden = expanded;
    filterToggle.innerHTML = expanded
      ? 'More filters <span aria-hidden="true">⌄</span>'
      : 'Fewer filters <span aria-hidden="true">⌃</span>';
  });
  form?.addEventListener('reset', () => {
    currentPage = 1;
    setTimeout(() => apply());
  });
  fields.forEach((name) =>
    form?.elements.namedItem(name)?.addEventListener('change', () => {
      currentPage = 1;
      apply();
    }),
  );
  form?.elements.namedItem('q')?.addEventListener('input', () => {
    currentPage = 1;
    apply();
  });
  pagination?.addEventListener('click', (event) => {
    const link = event.target.closest('[data-page]');
    if (!link) return;
    event.preventDefault();
    currentPage = Number(link.dataset.page) || 1;
    apply();
    results?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  apply(false);
</script>
