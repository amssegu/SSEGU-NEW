---
import type { WorkCourse } from '../../lib/work';
import { courseStatusLabel, isSafeCourseUrl } from '../../lib/work';

interface Props {
  course: WorkCourse;
}

const { course } = Astro.props;
const providerUrl =
  course.researchStatus !== 'needs-recheck' && isSafeCourseUrl(course.sourceUrl)
    ? course.sourceUrl
    : undefined;
const details = [course.category ?? course.subject, course.level, course.duration].filter(Boolean);
---

<article
  class="work-resource-card"
  data-course-card
  data-subject={course.subject ?? ''}
  data-provider={course.provider}
  data-level={course.level ?? ''}
  data-delivery={course.deliveryMode ?? ''}
  data-price={course.coursePriceStatus ?? 'unknown'}
  data-certificate={course.certificatePriceStatus ?? 'unknown'}
>
  <span class="work-resource-icon" aria-hidden="true">
    ◆
  </span>
  <p class="work-card-kicker">{course.format}</p>
  <h2>
    <a href={`/work/courses/${course.slug}/`}>{course.title}</a>
  </h2>
  <p class="work-resource-provider">{course.provider}</p>
  {course.approvalStatus === 'approved' && course.publicationStatus === 'published' ? <p class="work-resource-meta">Approved · Published</p> : <p class="work-course-attribution"><strong>Research draft:</strong> not approved and published.</p>}
  <p>{course.description}</p>
  {details.length > 0 && <p class="work-resource-meta">{details.join(' · ')}</p>}
  <div class="work-course-facts">
    <span><strong>Access</strong>{courseStatusLabel(course.coursePriceStatus)}</span>
    <span><strong>Credential</strong>{course.credentialType ?? courseStatusLabel(course.certificatePriceStatus)}</span>
  </div>
  {course.researchStatus && <p class="work-resource-meta">Research status: {courseStatusLabel(course.researchStatus)}</p>}
  <div class="work-resource-card-actions">
    <a class="work-text-link" href={`/work/courses/${course.slug}/`}>
      View course →
    </a>
    {providerUrl && (
      <a class="work-text-link" href={providerUrl} target="_blank" rel="noreferrer">
        Start at provider ↗
      </a>
    )}
  </div>
</article>
