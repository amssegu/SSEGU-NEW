---
import { tvChannels } from './tv';

const filters = ['all', 'News', 'Entertainment', 'Sports', 'Community', 'Faith'];
---

<section class="tv-catalog" aria-labelledby="tv-catalog-title">
  <div class="tv-brand">
    <h1 id="tv-catalog-title">
      SSEGU <span>📺</span> Live TV
    </h1>
    <p>Watch free live TV channels</p>
  </div>
  <div class="tv-search-wrap">
    <label class="sr-only" for="tv-search">
      Search channels
    </label>
    <input id="tv-search" type="search" placeholder="Search channels…" autocomplete="off" />
  </div>
  <div class="tv-tabs" id="tv-tabs" aria-label="Filter channels">
    {filters.map((filter) => (
      <button
        class:list={['tv-tab', { active: filter === 'all' }]}
        type="button"
        data-filter={filter}
      >
        {filter === 'all' ? 'ALL' : filter}
      </button>
    ))}
  </div>
  <div class="tv-heading">
    <h2>Live Channels</h2>
    <span id="tv-count">{tvChannels.length} channels</span>
  </div>
  <div class="tv-grid" id="tv-catalog-grid">
    {tvChannels.map((channel) => (
      <a
        class="tv-card"
        href={`/tv/${channel.id}/`}
        data-category={channel.category}
        data-name={`${channel.name} ${channel.category}`.toLowerCase()}
      >
        <div class="tv-poster">
          <img
            src={`https://via.placeholder.com/400x225/${channel.color.slice(1)}/ffffff?text=${encodeURIComponent(channel.name)}`}
            alt={channel.name}
            width="400"
            height="225"
            loading="lazy"
          />
          <span class="tv-badge">LIVE</span>
          <span class="tv-overlay" aria-hidden="true">
            <span class="tv-play">▶</span>
          </span>
        </div>
        <div class="tv-info">
          <strong>{channel.name}</strong>
          <small>{channel.category}</small>
        </div>
      </a>
    ))}
    <div class="tv-empty" id="tv-empty" hidden>
      No channels found.
    </div>
  </div>
</section>

<script lang="ts">
  const searchInput = document.getElementById('tv-search');
  const count = document.querySelector('#tv-count');
  const empty = document.querySelector('#tv-empty');
  const cards = [...document.querySelectorAll('[data-category][data-name]')];
  let activeFilter = 'all';

  const render = () => {
    const query =
      searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : '';
    let visible = 0;
    cards.forEach((card) => {
      const matchesFilter =
        activeFilter === 'all' || card.getAttribute('data-category') === activeFilter;
      const matchesQuery = !query || (card.getAttribute('data-name') || '').includes(query);
      const show = matchesFilter && matchesQuery;
      card.toggleAttribute('hidden', !show);
      if (show) visible += 1;
    });
    if (count) count.textContent = `${visible} channels`;
    if (empty) empty.toggleAttribute('hidden', visible !== 0);
  };

  searchInput?.addEventListener('input', render);
  document.querySelectorAll('[data-filter]').forEach((tab) => {
    tab.addEventListener('click', () => {
      activeFilter = tab.getAttribute('data-filter') || 'all';
      document
        .querySelectorAll('[data-filter]')
        .forEach((item) => item.classList.toggle('active', item === tab));
      render();
    });
  });
</script>

<style>
  :global(body:has(.tv-catalog)) {
    background: #0b0b0f;
  }
  .tv-catalog {
    width: 100%;
    margin: 0 auto;
    max-width: 1440px;
    padding: 30px 24px 56px;
    color: #e8e8ed;
    background: #0b0b0f;
  }
  .tv-brand {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 10px 0 20px;
    text-align: left;
  }
  .tv-brand h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(30px, 4.5vw, 52px);
    font-weight: 900;
    letter-spacing: -0.5px;
  }
  .tv-brand h1 span {
    color: #d95c4b;
  }
  .tv-brand p {
    margin: 0 0 5px;
    color: #8a8a96;
    font-size: 13px;
  }
  .tv-search-wrap {
    max-width: 520px;
    margin: 0 0 14px auto;
  }
  .tv-search-wrap input {
    width: 100%;
    height: 46px;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 8px;
    background: #16161d;
    color: #fff;
    outline: none;
    padding: 0 16px;
    font-size: 16px;
  }
  .tv-search-wrap input:focus {
    border-color: #d95c4b;
    box-shadow: 0 0 0 3px rgb(225 29 72 / 18%);
  }
  .tv-tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 16px;
  }
  .tv-tab {
    appearance: none;
    border: 1px solid rgb(255 255 255 / 12%);
    background: #16161d;
    color: #bbb;
    border-radius: 5px;
    padding: 8px 14px;
    cursor: pointer;
    font-weight: 800;
    font-size: 12px;
    transition: 0.15s;
  }
  .tv-tab:hover,
  .tv-tab.active {
    background: #d95c4b;
    border-color: #d95c4b;
    color: #fff;
  }
  .tv-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 12px;
  }
  .tv-heading h2 {
    margin: 0;
    font-size: 18px;
    color: #fff;
    font-weight: 800;
  }
  #tv-count {
    color: #8a8a96;
    font-size: 12px;
    font-weight: 700;
  }
  .tv-grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 16px;
  }
  .tv-card {
    background: #14141a;
    border-radius: 8px;
    border: 2px solid rgb(255 255 255 / 6%);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: block;
    transition:
      transform 0.18s,
      border-color 0.18s;
  }
  .tv-card:hover,
  .tv-card:focus-visible {
    transform: translateY(-3px);
    border-color: #d95c4b;
  }
  .tv-poster {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #1c1c24;
    overflow: hidden;
  }
  .tv-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tv-badge {
    position: absolute;
    left: 7px;
    top: 7px;
    background: #d95c4b;
    color: #fff;
    font-size: 9px;
    font-weight: 900;
    padding: 3px 7px;
    border-radius: 5px;
  }
  .tv-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(0 0 0 / 35%);
    opacity: 0;
    transition: opacity 0.18s;
  }
  .tv-card:hover .tv-overlay,
  .tv-card:focus-visible .tv-overlay {
    opacity: 1;
  }
  .tv-play {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #d95c4b;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 900;
  }
  .tv-info {
    padding: 9px 10px 11px;
  }
  .tv-info strong,
  .tv-info small {
    display: block;
  }
  .tv-info strong {
    color: #fff;
    font-weight: 800;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tv-info small {
    margin-top: 3px;
    font-size: 11px;
    color: #8a8a96;
  }
  .tv-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px 16px;
    color: #8a8a96;
    font-weight: 700;
    background: #14141a;
    border-radius: 14px;
    border: 1px solid rgb(255 255 255 / 6%);
  }
  [hidden] {
    display: none !important;
  }
  @media (min-width: 900px) {
    .tv-grid {
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
      gap: 14px;
    }
  }
  @media (max-width: 600px) {
    .tv-brand {
      display: block;
    }
    .tv-catalog {
      padding-inline: 14px;
    }
    .tv-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
  }
</style>
