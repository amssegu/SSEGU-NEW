---
import type { TvChannel } from './tv';

interface Props {
  channel: TvChannel;
}
const { channel } = Astro.props;
---

<section class="tv-player-page" aria-labelledby="tv-player-title">
  <div class="tv-player-brand">
    <h1>
      SSEGU <span>📺</span> Live TV
    </h1>
    <p>Watch free live TV channels</p>
  </div>
  <div class="tv-back-row">
    <a class="tv-back-link" href="/tv/">
      ← Back to Channels
    </a>
    <div class="tv-channel-title" id="tv-player-title">
      {channel.name}
    </div>
  </div>
  <div class="tv-player-wrap">
    <video id="tv-video" playsinline controls preload="metadata"></video>
    <div class="tv-player-overlay" id="tv-play-overlay">
      <button
        class="tv-play-button"
        id="tv-play-button"
        type="button"
        aria-label={`Play ${channel.name}`}
      >
        ▶
      </button>
      <div class="tv-hint">Tap to play {channel.name}</div>
    </div>
    <div class="tv-player-overlay is-hidden" id="tv-load-overlay">
      <div class="tv-load-text" id="tv-load-text">
        Connecting…
      </div>
    </div>
    <div class="tv-player-overlay is-hidden" id="tv-error-overlay">
      <div class="tv-error-box">
        <p>Unable to load stream. Please try again.</p>
        <button class="tv-retry-button" id="tv-retry-button" type="button">
          Retry
        </button>
      </div>
    </div>
  </div>
  <div class="tv-meta-bar">
    <span class="tv-live-badge">● LIVE</span>
    <span class="tv-category">{channel.category}</span>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.17" is:inline></script>

<script define:vars={{ streamUrl: channel.stream, channelName: channel.name }}>
  const Hls = window.Hls;

  const video = document.querySelector('#tv-video');
  const playOverlay = document.querySelector('#tv-play-overlay');
  const loadOverlay = document.querySelector('#tv-load-overlay');
  const errorOverlay = document.querySelector('#tv-error-overlay');
  const loadText = document.querySelector('#tv-load-text');
  const playButton = document.querySelector('#tv-play-button');
  const retryButton = document.querySelector('#tv-retry-button');
  let currentHls = null;
  let loadTimeout;
  let resolved = false;

  const showOnly = (state) => {
    playOverlay?.classList.toggle('is-hidden', state !== 'play');
    loadOverlay?.classList.toggle('is-hidden', state !== 'load');
    errorOverlay?.classList.toggle('is-hidden', state !== 'error');
  };
  const destroyHls = () => {
    currentHls?.destroy();
    currentHls = null;
    if (loadTimeout) window.clearTimeout(loadTimeout);
  };
  const showError = () => {
    destroyHls();
    showOnly('error');
  };
  const showReady = () => {
    if (resolved) return;
    resolved = true;
    if (loadTimeout) window.clearTimeout(loadTimeout);
    video
      ?.play()
      .then(() => showOnly('none'))
      .catch(() => showOnly('play'));
  };
  const attachStream = () => {
    if (!video) return;
    destroyHls();
    resolved = false;
    showOnly('load');
    if (loadText) loadText.textContent = `Connecting to ${channelName}…`;
    loadTimeout = window.setTimeout(() => {
      if (!resolved) showError();
    }, 18000);
    if (Hls?.isSupported()) {
      currentHls = new Hls({
        enableWorker: true,
        lowLatencyMode: true,
        backBufferLength: 60,
        maxBufferLength: 30,
      });
      currentHls.loadSource(streamUrl);
      currentHls.attachMedia(video);
      currentHls.on(Hls.Events.MANIFEST_PARSED, showReady);
      currentHls.on(Hls.Events.ERROR, (_event, data) => {
        if (!data.fatal) return;
        if (data.type === Hls.ErrorTypes.NETWORK_ERROR) currentHls?.startLoad();
        else if (data.type === Hls.ErrorTypes.MEDIA_ERROR) currentHls?.recoverMediaError();
        else showError();
      });
    } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = streamUrl;
      video.addEventListener('loadedmetadata', showReady, { once: true });
    } else {
      video.src = streamUrl;
      video.addEventListener('loadedmetadata', showReady, { once: true });
    }
    video.addEventListener('error', showError, { once: true });
  };
  playButton?.addEventListener('click', (event) => {
    event.preventDefault();
    attachStream();
  });
  playOverlay?.addEventListener('click', (event) => {
    if (event.target === playOverlay) attachStream();
  });
  retryButton?.addEventListener('click', attachStream);
  window.addEventListener('pagehide', destroyHls, { once: true });
</script>

<style>
  :global(body:has(.tv-player-page)) {
    background: #0b0b0f;
  }
  .tv-player-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 16px 14px 40px;
    color: #e8e8ed;
    background: #0b0b0f;
  }
  .tv-player-brand {
    text-align: center;
    padding: 8px 0 12px;
  }
  .tv-player-brand h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(22px, 4vw, 32px);
    font-weight: 900;
    letter-spacing: -0.5px;
  }
  .tv-player-brand h1 span {
    color: #e11d48;
  }
  .tv-player-brand p {
    margin: 4px 0 0;
    color: #8a8a96;
    font-size: 13px;
  }
  .tv-back-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .tv-back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #c0c0d0;
    font-weight: 700;
    font-size: 14px;
    padding: 8px 12px;
    border-radius: 10px;
    background: #16161d;
    border: 1px solid rgb(255 255 255 / 10%);
    text-decoration: none;
  }
  .tv-back-link:hover {
    border-color: #e11d48;
    color: #fff;
  }
  .tv-channel-title {
    font-size: 18px;
    font-weight: 800;
    color: #fff;
  }
  .tv-player-wrap {
    position: relative;
    background: #000;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 8%);
    aspect-ratio: 16 / 9;
    max-height: 70vh;
  }
  #tv-video {
    width: 100%;
    height: 100%;
    display: block;
    background: #000;
    object-fit: contain;
  }
  .tv-player-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgb(0 0 0 / 55%);
    z-index: 5;
    cursor: pointer;
  }
  .tv-player-overlay.is-hidden {
    display: none;
  }
  .tv-play-button {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #e11d48;
    color: #fff;
    border: none;
    font-size: 28px;
    font-weight: 900;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgb(225 29 72 / 40%);
  }
  .tv-play-button:hover {
    transform: scale(1.05);
  }
  .tv-hint {
    margin-top: 12px;
    color: #ccc;
    font-size: 13px;
    font-weight: 600;
  }
  .tv-load-text {
    color: #fff;
    font-weight: 700;
    font-size: 15px;
  }
  .tv-error-box {
    text-align: center;
    padding: 20px;
  }
  .tv-error-box p {
    color: #fca5a5;
    margin-bottom: 12px;
    font-weight: 700;
  }
  .tv-retry-button {
    border: none;
    background: #e11d48;
    color: #fff;
    font-weight: 800;
    padding: 10px 18px;
    border-radius: 10px;
    cursor: pointer;
  }
  .tv-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tv-live-badge {
    background: #e11d48;
    color: #fff;
    font-size: 11px;
    font-weight: 900;
    padding: 4px 10px;
    border-radius: 6px;
  }
  .tv-category {
    color: #8a8a96;
    font-size: 13px;
    font-weight: 700;
  }
</style>
