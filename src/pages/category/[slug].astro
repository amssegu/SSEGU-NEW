---
import MainLayout from '../../layouts/MainLayout.astro';
import StoryCard from '../../components/main/StoryCard.astro';
import Pagination from '../../components/main/Pagination.astro';
import {
  categories,
  CATEGORY_PAGE_SIZE,
  getPublishedArticles,
  label,
  pageCount,
  pageItems,
} from '../../lib/articles';
import AdSlot from '../../components/main/AdSlot.astro';
export function getStaticPaths() {
  return categories
    .filter((category) => category !== 'news')
    .map((slug) => ({ params: { slug }, props: { slug } }));
}
const { slug } = Astro.props;
const allStories = await getPublishedArticles(slug);
const totalPages = pageCount(allStories.length, CATEGORY_PAGE_SIZE);
const stories = pageItems(allStories, 1, CATEGORY_PAGE_SIZE);
---

<MainLayout
  title={`${label(slug)} | SSEGU`}
  description={`Fixture ${label(slug)} stories from SSEGU.`}
>
  <div class="shell page-wrap">
    <p class="eyebrow">Section</p>
    <h1>{label(slug)}</h1>
    <AdSlot placement="top" format="horizontal" />
    {stories.length ? (
      <>
        <div class="category-content">
          <section class="category-main" aria-label={`${label(slug)} stories`}>
            <div class="listing-grid">
              {stories.map((article) => (
                <StoryCard article={article} />
              ))}
            </div>
            <Pagination currentPage={1} totalPages={totalPages} basePath={`/category/${slug}/`} />
          </section>
          <aside class="category-sidebar" aria-label="Advertisement">
            <AdSlot placement="sidebar" format="rectangle" minHeight={250} />
            <AdSlot placement="section" format="rectangle" minHeight={600} />
          </aside>
        </div>
      </>
    ) : (
      <p class="empty-state">No stories are available in this section yet.</p>
    )}
  </div>
</MainLayout>
