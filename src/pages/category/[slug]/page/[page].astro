---
import MainLayout from '../../../../layouts/MainLayout.astro';
import StoryCard from '../../../../components/main/StoryCard.astro';
import Pagination from '../../../../components/main/Pagination.astro';
import {
  CATEGORY_PAGE_SIZE,
  categories,
  getPublishedArticles,
  label,
  pageCount,
  pageItems,
} from '../../../../lib/articles';
import AdSlot from '../../../../components/main/AdSlot.astro';

export async function getStaticPaths() {
  const paths = [];
  for (const slug of categories.filter((category) => category !== 'news')) {
    const allStories = await getPublishedArticles(slug);
    const totalPages = pageCount(allStories.length, CATEGORY_PAGE_SIZE);
    for (let currentPage = 2; currentPage <= totalPages; currentPage += 1) {
      paths.push({
        params: { slug, page: String(currentPage) },
        props: {
          slug,
          currentPage,
          totalPages,
          stories: pageItems(allStories, currentPage, CATEGORY_PAGE_SIZE),
        },
      });
    }
  }
  return paths;
}

const { slug, currentPage, totalPages, stories } = Astro.props;
---

<MainLayout
  title={`${label(slug)} — Page ${currentPage} | SSEGU`}
  description={`SSEGU ${label(slug)} stories, page ${currentPage}.`}
>
  <div class="shell page-wrap category-page-shell">
    <p class="eyebrow">Section</p>
    <h1>{label(slug)}</h1>
    <div class="category-content">
      <section class="category-main" aria-label={`${label(slug)} stories`}>
        <div class="listing-grid">
            {stories.slice(0, 3).map((article) => (
            <StoryCard article={article} />
          ))}
            <AdSlot placement="section" format="horizontal" />
            {stories.slice(3).map((article) => (
              <StoryCard article={article} />
            ))}
        </div>
        <Pagination currentPage={currentPage} totalPages={totalPages} basePath={`/category/${slug}/`} />
      </section>
      <aside class="category-sidebar" aria-label="Advertisement">
        <AdSlot placement="sidebar" format="rectangle" minHeight={250} />
      </aside>
    </div>
  </div>
</MainLayout>
