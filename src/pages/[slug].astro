---
import MainLayout from '../layouts/MainLayout.astro';
import TopStories from '../components/main/TopStories.astro';
import {
  articles,
  formatDate,
  fromContentEntry,
  getPublishedArticles,
  label,
} from '../lib/articles';
import AdSlot from '../components/main/AdSlot.astro';
import { absoluteUrl, articleJsonLd, breadcrumbJsonLd } from '../lib/seo';
import { estimateReadingTime, normalizeArticleBody, stripLegacyArticleLead } from '../lib/content';
import { selectRecommendations } from '../lib/recommendations';
import { getCollection, render, type CollectionEntry } from 'astro:content';
export async function getStaticPaths() {
  const entries = (await getCollection('articles')).filter(
    ({ data }) => data.status === 'published',
  );
  const contentSlugs = new Set(entries.map((entry) => entry.data.slug));
  const allArticles = await getPublishedArticles();
  const relatedFor = (article: (typeof articles)[number]) =>
    selectRecommendations(
      allArticles.filter(
        (item) =>
          item.slug !== article.slug &&
          item.categories.some((category) => article.categories.includes(category)),
      ),
      article.slug,
      10,
    );
  return [
    ...articles
      .filter((article) => !contentSlugs.has(article.slug))
      .map((article) => ({
        params: { slug: article.slug },
        props: { article, related: relatedFor(article), topStories: allArticles.slice(0, 6) },
      })),
    ...entries.map((entry) => {
      const article = allArticles.find((item) => item.slug === entry.data.slug)!;
      return {
        params: { slug: entry.data.slug },
        props: {
          entry,
          article,
          related: relatedFor(article),
          topStories: allArticles.slice(0, 6),
        },
      };
    }),
  ];
}
const { article: fixtureArticle, entry } = Astro.props as {
  article?: (typeof articles)[number];
  related?: (typeof articles)[number][];
  topStories?: (typeof articles)[number][];
  entry?: CollectionEntry<'articles'>;
};
const article = fixtureArticle ?? fromContentEntry(entry!);
const related = Astro.props.related ?? [];
const topStories = Astro.props.topStories ?? [];
const topStorySlugs = new Set(topStories.map((item) => item.slug));
const relatedStories = related.filter((item) => !topStorySlugs.has(item.slug)).slice(0, 4);
const truncateRelatedTitle = (title: string, maxLength = 58) => {
  if (title.length <= maxLength) return title;
  const shortened = title.slice(0, maxLength).trimEnd();
  const wordBoundary = shortened.lastIndexOf(' ');
  return `${shortened.slice(0, wordBoundary > 40 ? wordBoundary : maxLength)}…`;
};
const { Content } = entry ? await render(entry) : { Content: undefined };
const rawBody = entry?.body ?? '';
const cleanedBody = entry
  ? normalizeArticleBody(stripLegacyArticleLead(rawBody) ?? rawBody)
  : undefined;
const hasNormalizedBody = Boolean(entry && cleanedBody !== rawBody);
const readingTime = estimateReadingTime(entry?.body ?? article.body);
const canonical = absoluteUrl(`/${article.slug}/`);
const structuredData = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: label(article.category), path: `/category/${article.category}/` },
    { name: article.title },
  ]),
  articleJsonLd({
    headline: article.title,
    description: article.description,
    image: article.image,
    datePublished: article.publishedAt,
    author: article.author,
    path: `/${article.slug}/`,
    section: label(article.category),
  }),
];
---

<MainLayout
  title={`${article.title} | SSEGU`}
  description={article.description}
  canonical={canonical}
  image={article.image}
  type="article"
  publishedAt={article.publishedAt}
  updatedAt={article.updatedAt}
  author={article.author}
  section={label(article.category)}
  structuredData={structuredData}
>
  <article class="shell article-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href={`/category/${article.category}/`}>{label(article.category)}</a>
      <span>/</span>
      <span aria-current="page">{article.title}</span>
    </nav>
    <div class="article-reading-layout">
      <div class="article-main-column">
        <div class="article-taxonomy" aria-label="Article categories">
          {article.categories.map((category) => (
            <a
              class:list={['category-label', `category-${category}`]}
              href={`/category/${category}/`}
            >
              {label(category)}
            </a>
          ))}
        </div>
        <h1>{article.title}</h1>
        <p class="article-dek">{article.description}</p>
        <p class="article-meta">
          By {article.author} ·{' '}
          <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
          {article.updatedAt && article.updatedAt !== article.publishedAt && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated {formatDate(article.updatedAt)}</span>
            </>
          )}
        </p>
        {article.tags.length > 0 && (
          <ul class="article-tags" aria-label="Article tags">
            {article.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}
        <picture>
          {!article.image.startsWith('http') && (
            <source srcset={article.imageAvif} type="image/avif" />
          )}
          {!article.image.startsWith('http') && <source srcset={article.image} type="image/webp" />}
          <img
            class="article-cover"
            src={article.image}
            data-fallback-src={article.imageFallback}
            alt={article.imageAlt ?? `Illustration for ${article.title}`}
            loading="eager"
            decoding="async"
            width="1200"
            height="675"
          />
        </picture>
        <AdSlot placement="article" format="horizontal" minHeight={60} />
        <div class="article-body">
          {hasNormalizedBody ? (
            <div set:html={cleanedBody} />
          ) : Content ? (
            <Content />
          ) : (
            article.body.map((paragraph) => <p>{paragraph}</p>)
          )}
        </div>
        <template id="article-inline-ad-template">
          <AdSlot placement="article" format="horizontal" minHeight={60} />
        </template>
        {relatedStories.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title">Related stories</h2>
            <div class="related-links">
              {relatedStories.map((item) => (
                <a class="related-card" href={`/${item.slug}/`}>
                  <img
                    src={item.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="320"
                    height="180"
                  />
                  <span class="related-card-copy">
                    <strong>{truncateRelatedTitle(item.title)}</strong>
                    <small>{item.description}</small>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
      {topStories.length > 0 && (
        <aside class="article-top-stories" aria-label="Top Stories">
          <TopStories articles={topStories} />
          <AdSlot placement="sidebar" format="rectangle" minHeight={120} />
        </aside>
      )}
    </div>
  </article>
</MainLayout>

<script is:inline>
  const articleBody = document.querySelector('.article-body');
  const inlineAdTemplate = document.querySelector('#article-inline-ad-template');
  if (articleBody && inlineAdTemplate) {
    const paragraphs = [...articleBody.querySelectorAll('p')];
    const adCount = Math.min(5, Math.max(2, Math.floor(paragraphs.length / 3)));
    const insertionIndexes = new Set(
      Array.from({ length: adCount }, (_, index) =>
        Math.min(
          paragraphs.length - 1,
          Math.floor(((index + 1) * paragraphs.length) / (adCount + 1)),
        ),
      ),
    );

    insertionIndexes.forEach((paragraphIndex) => {
      const ad = inlineAdTemplate.content.cloneNode(true);
      paragraphs[paragraphIndex]?.after(ad);
    });

    if (document.querySelector('script[data-ssegu-adsense]')) {
      document
        .querySelectorAll('.article-body .adsbygoogle:not([data-ad-requested])')
        .forEach((ad) => {
          ad.setAttribute('data-ad-requested', '1');
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (error) {
            ad.removeAttribute('data-ad-requested');
            console.warn('AdSense could not load this inline ad slot.', error);
          }
        });
    }
  }
  document.querySelectorAll('img[data-fallback-src]').forEach((image) => {
    image.addEventListener(
      'error',
      () => {
        const fallback = image.dataset.fallbackSrc;
        if (fallback && image.getAttribute('src') !== fallback) {
          image.setAttribute('src', fallback);
        }
      },
      { once: true },
    );
  });
</script>
