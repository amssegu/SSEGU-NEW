---
import MainLayout from '../layouts/MainLayout.astro';
import { articles, formatDate, label } from '../lib/articles';
import AdSlot from '../components/main/AdSlot.astro';
import { absoluteUrl, articleJsonLd, breadcrumbJsonLd } from '../lib/seo';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { referenceId } from '../lib/content';
export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => data.status === 'published');
  const contentSlugs = new Set(entries.map((entry) => entry.data.slug));
  return [
    ...articles
      .filter((article) => !contentSlugs.has(article.slug))
      .map((article) => ({ params: { slug: article.slug }, props: { article } })),
    ...entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } })),
  ];
}
const { article: fixtureArticle, entry } = Astro.props as {
  article?: (typeof articles)[number];
  entry?: CollectionEntry<'articles'>;
};
const article = fixtureArticle ?? {
  slug: entry!.data.slug,
  title: entry!.data.title,
  description: entry!.data.metaDescription ?? entry!.data.excerpt,
  category: referenceId(entry!.data.categories[0]) || 'news',
  author:
    referenceId(entry!.data.author) === 'editorial-desk'
      ? 'SSEGU Editorial Desk'
      : referenceId(entry!.data.author),
  publishedAt: entry!.data.publishedAt.toISOString().slice(0, 10),
  image: entry!.data.image ?? '/uploads/article-ict.webp',
  imageAvif: entry!.data.image?.endsWith('.avif') ? entry!.data.image : '/uploads/article-ict.avif',
  body: [],
};
const related = articles
  .filter((item) => !entry && item.slug !== article.slug && item.category === article.category)
  .slice(0, 3);
const { Content } = entry ? await render(entry) : { Content: undefined };
const canonical = absoluteUrl(`/${article.slug}/`);
const structuredData = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: label(article.category), path: `/category/${article.category}/` },
    { name: article.title },
  ]),
  articleJsonLd({
    headline: article.title,
    description: article.description,
    image: article.image,
    datePublished: article.publishedAt,
    author: article.author,
    path: `/${article.slug}/`,
    section: label(article.category),
  }),
];
---

<MainLayout
  title={`${article.title} | SSEGU`}
  description={article.description}
  canonical={canonical}
  image={article.image}
  type="article"
  publishedAt={article.publishedAt}
  author={article.author}
  section={label(article.category)}
  structuredData={structuredData}
>
  <article class="shell article-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href={`/category/${article.category}/`}>{label(article.category)}</a>
      <span>/</span>
      <span aria-current="page">Article</span>
    </nav>
    <p class="eyebrow">{label(article.category)}</p>
    <h1>{article.title}</h1>
    <p class="article-dek">{article.description}</p>
    <p class="article-meta">
      By {article.author} ·{' '}
      <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
    </p>
    <picture>
      <source srcset={article.imageAvif} type="image/avif" />
      <source srcset={article.image} type="image/webp" />
      <img
        class="article-cover"
        src={article.image}
        alt={`Illustration for ${article.title}`}
        width="1200"
        height="675"
      />
    </picture>
    <AdSlot placement="article" />
    <div class="article-body">
      {Content ? <Content /> : article.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title">Related stories</h2>
        <div class="related-links">
          {related.map((item) => (
            <a href={`/${item.slug}/`}>{item.title}</a>
          ))}
        </div>
      </section>
    )}
  </article>
</MainLayout>
