---
import MainLayout from '../../layouts/MainLayout.astro';
import LiveTvPlayer from '../../components/main/LiveTvPlayer.astro';
import { liveTvChannels } from '../../lib/live-tv';
import { absoluteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return liveTvChannels.map((channel) => ({
    params: { channel: channel.id },
    props: { channel },
  }));
}

const { channel } = Astro.props;
---

<MainLayout
  title={`${channel.name} Live TV | SSEGU`}
  description={`Watch ${channel.name}, a live ${channel.category.toLowerCase()} channel on SSEGU.`}
  canonical={absoluteUrl(`/tv/${channel.id}/`)}
>
  <LiveTvPlayer channel={channel} />
</MainLayout>
