---
import MainLayout from '../../layouts/MainLayout.astro';
import TVPlayer from '../../components/TV/TVPlayer.astro';
import { tvChannels } from '../../components/TV/tv';
import { absoluteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return tvChannels.map((channel) => ({
    params: { channel: channel.id },
    props: { channel },
  }));
}

const { channel } = Astro.props;
---

<MainLayout
  title={`${channel.name} Live TV | SSEGU`}
  description={`Watch ${channel.name}, a live ${channel.category.toLowerCase()} channel on SSEGU.`}
  canonical={absoluteUrl(`/tv/${channel.id}/`)}
>
  <TVPlayer channel={channel} />
</MainLayout>
