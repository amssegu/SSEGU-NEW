---
import MainLayout from '../../layouts/MainLayout.astro';
import AdSlot from '../../components/main/AdSlot.astro';

const directUrl = import.meta.env.PUBLIC_LIVE_TV_URL || 'https://www.ssegu.com/tv/';
const embedUrl = import.meta.env.PUBLIC_LIVE_TV_EMBED_URL;
---

<MainLayout
  title="Live TV | SSEGU"
  description="Watch M2A Live TV channels inside the SSEGU news experience."
>
  <div class="live-tv-page shell">
    <AdSlot placement="top" format="horizontal" />
    {embedUrl ? (
      <div class="live-tv-embed-shell">
        <iframe
          src={embedUrl}
          title="M2A Live TV"
          loading="eager"
          allow="autoplay; fullscreen; picture-in-picture"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    ) : (
      <div class="live-tv-embed-help">
        <p>
          The live player is hosted separately and cannot be embedded by this site. Open M2A Live TV
          directly to watch the available channels.
        </p>
        <a class="button" href={directUrl} target="_blank" rel="noopener">
          Open M2A Live TV ↗
        </a>
      </div>
    )}

    {embedUrl && (
      <div class="live-tv-embed-help">
        <p>If your browser blocks the embedded player, open it directly instead.</p>
        <a class="button" href={directUrl} target="_blank" rel="noopener">
          Open M2A Live TV ↗
        </a>
      </div>
    )}
  </div>
</MainLayout>
