---
import MainLayout from '../layouts/MainLayout.astro';
import BreakingNews from '../components/main/BreakingNews.astro';
import StoryCard from '../components/main/StoryCard.astro';
import TopStories from '../components/main/TopStories.astro';
import NewsletterModule from '../components/main/NewsletterModule.astro';
import SectionLinks from '../components/main/SectionLinks.astro';
import LiveTvModule from '../components/main/LiveTvModule.astro';
import AdSlot from '../components/main/AdSlot.astro';
import { getPublishedArticles, label } from '../lib/articles';
const stories = await getPublishedArticles();
const lead = stories[0];
const supporting = stories.slice(1, 4);
const belowLead = stories.slice(4, 6);
const moreNews = stories.slice(5);
---

<MainLayout
  title="SSEGU | Inform. Educate. Empower."
  description="The latest news, analysis and useful stories from SSEGU."
>
  <BreakingNews />
  <AdSlot placement="top" format="horizontal" />
  <div class="shell home-grid">
    <section class="lead-area" aria-labelledby="lead-title">
      <div class="lead-primary">
        <article class="lead-story">
          <a href={`/${lead.slug}/`}>
            <picture>
              <source srcset={lead.imageAvif} type="image/avif" />
              <source srcset={lead.image} type="image/webp" />
              <img
                src={lead.image}
                alt={`Illustration for ${lead.title}`}
                width="1200"
                height="675"
              />
            </picture>
          </a>
          <div class="lead-overlay">
            <p class:list={['category-label', `category-${lead.category}`]}>
              {label(lead.category)}
            </p>
            <h1 id="lead-title">
              <a href={`/${lead.slug}/`}>{lead.title}</a>
            </h1>
            <p>{lead.description}</p>
            <a class="read-more" href={`/${lead.slug}/`}>
              Read more →
            </a>
          </div>
        </article>
        <div class="below-lead-stories" aria-label="More featured stories">
          {belowLead.map((article) => (
            <StoryCard article={article} />
          ))}
        </div>
      </div>
      <div class="supporting-stories">
        {supporting.map((article) => (
          <StoryCard article={article} compact />
        ))}
      </div>
    </section>
    <aside class="home-sidebar">
      <TopStories articles={stories} />
      <NewsletterModule />
    </aside>
  </div>
  <AdSlot placement="section" format="horizontal" />
  <div class="shell lower-grid">
    <section>
      <div class="section-heading">
        <h2>More News</h2>
        <a href="/news/">View all news →</a>
      </div>
      <div class="card-grid">
        {moreNews.map((article) => (
          <StoryCard article={article} />
        ))}
      </div>
    </section>
    <aside>
      <SectionLinks />
    </aside>
  </div>
  <AdSlot placement="section" format="horizontal" />
  <LiveTvModule />
  <AdSlot placement="section" format="horizontal" />
</MainLayout>
