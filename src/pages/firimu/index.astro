---
import FirimuCard from '../../components/firimu/FirimuCard.astro';
import FirimuFilters from '../../components/firimu/FirimuFilters.astro';
import FirimuLayout from '../../layouts/FirimuLayout.astro';
import FirimuRail from '../../components/firimu/FirimuRail.astro';
import { getFirimuItems } from '../../lib/firimu';

const items = await getFirimuItems();
const featured = items[0];
const uniqueGenres = [
  ...new Set(items.map((item) => item.genre).filter((genre) => genre !== 'Film')),
].slice(0, 8);
const featuredVj = featured ? items.filter((item) => item.vj === featured.vj).slice(0, 10) : [];
const actionFilms = items.filter((item) => /action|thriller/i.test(item.genre)).slice(0, 10);
const newFilms = items.slice(0, 10);
---

<FirimuLayout
  title="Firimu | SSEGU"
  description="A dedicated SSEGU catalogue for films, VJ voices and stories from Uganda and beyond."
  image={featured?.poster}
>
  {featured ? (
    <section class="firimu-hero" aria-labelledby="firimu-hero-title">
      <img src={featured.poster} alt="" width="1400" height="800" fetchpriority="high" />
      <span class="firimu-hero-shade" aria-hidden="true"></span>
      <div class="firimu-hero-content">
        <span class="firimu-kicker">Featured on SSEGU Firimu</span>
        <h1 id="firimu-hero-title">{featured.article.title}</h1>
        <div class="firimu-hero-meta">
          <span>{featured.vj}</span>
          <span>{featured.genre}</span>
          {featured.runtime && <span>{featured.runtime}</span>}
          <span>{featured.article.publishedAt}</span>
        </div>
        <p>{featured.plot}</p>
        <div class="firimu-hero-actions">
          <a class="firimu-button" href={`/firimu/${featured.article.slug}/`}>
            Watch now
          </a>
          <a class="firimu-button secondary" href="#firimu-catalogue">
            Browse films
          </a>
        </div>
      </div>
    </section>
  ) : (
    <section class="firimu-empty">
      <span class="firimu-kicker">SSEGU Firimu</span>
      <h1>No films have been added yet.</h1>
      <p>Published posts containing the standalone word “VJ” will appear here automatically.</p>
    </section>
  )}

  <FirimuRail title="New on Firimu" eyebrow="Fresh from the catalogue" items={newFilms} />
  {featured && (
    <FirimuRail
      title={`${featured.vj} selections`}
      eyebrow="A voice behind the screen"
      items={featuredVj}
    />
  )}
  <FirimuRail title="Action and thrillers" eyebrow="For the night shift" items={actionFilms} />

  <FirimuFilters genres={uniqueGenres} />
  <section id="firimu-catalogue" class="firimu-catalogue" aria-label="All Firimu films">
    {items.map((item) => (
      <FirimuCard item={item} />
    ))}
  </section>
</FirimuLayout>

<script>
  const query = document.querySelector('#firimu-query');
  const resultCount = document.querySelector('#firimu-results');
  const cards = [...document.querySelectorAll('[data-firimu-card]')];
  const filters = [...document.querySelectorAll('[data-firimu-filter]')];
  let activeFilter = 'all';

  const render = () => {
    const search = query instanceof HTMLInputElement ? query.value.trim().toLowerCase() : '';
    let visible = 0;
    cards.forEach((card) => {
      const text = card.getAttribute('data-search') ?? '';
      const genre = card.getAttribute('data-genre') ?? '';
      const matchesSearch = !search || text.includes(search);
      const matchesFilter = activeFilter === 'all' || genre.includes(activeFilter);
      const show = matchesSearch && matchesFilter;
      card.toggleAttribute('hidden', !show);
      if (show) visible += 1;
    });
    if (resultCount)
      resultCount.textContent = `${visible} film${visible === 1 ? '' : 's'} in the catalogue`;
  };

  query?.addEventListener('input', render);
  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      activeFilter = filter.getAttribute('data-firimu-filter') ?? 'all';
      filters.forEach((item) => item.classList.toggle('is-active', item === filter));
      render();
    });
  });
  render();
</script>
