---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="SSEGU News Updates — top stories from CNN and BBC."><title>SSEGU News Updates</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet"><style>
:root{--bg:#f7f4ef;--paper:#fff;--ink:#121212;--muted:#5c5c5c;--line:#e0d9cf;--accent:#b91c1c;--serif:"Libre Baskerville",Georgia,serif;--sans:"Source Sans 3",system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.55}.mast{background:var(--ink);color:white;text-align:center;padding:28px 16px;border-bottom:4px solid var(--accent)}.mast h1{font:700 clamp(28px,6vw,46px)/1.1 var(--serif);margin:0}.mast span,.kicker{color:#ef4444}.mast p{font-size:13px;letter-spacing:.14em;text-transform:uppercase}.wrap{max-width:1100px;margin:auto;padding:24px 16px 48px}.search{width:100%;max-width:420px;padding:12px;border:1px solid var(--line);font:inherit}.filters{display:flex;gap:8px;margin:14px 0}.filters button{padding:8px 16px;border:1px solid var(--line);border-radius:99px;background:white;cursor:pointer}.filters .active{background:var(--ink);color:white}.status{font-size:12px;color:var(--muted)}.lead{display:grid;gap:16px;margin:20px 0}@media(min-width:850px){.lead{grid-template-columns:1.4fr 1fr}}.hero{position:relative;min-height:330px;background:#222;color:white;display:flex;align-items:end;text-decoration:none;overflow:hidden}.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.72}.hero div{position:relative;padding:24px;background:linear-gradient(transparent,rgba(0,0,0,.9));width:100%}.hero h2{font:700 28px/1.2 var(--serif)}.side{display:grid;gap:12px}.side article,.story{background:white;border:1px solid var(--line);padding:14px}.side h3,.story h3{font:700 16px/1.3 var(--serif)}.section{font:700 22px var(--serif);border-bottom:2px solid;padding-bottom:8px;margin:28px 0 16px}.grid{display:grid;grid-template-columns:1fr;gap:18px}@media(min-width:600px){.grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:960px){.grid{grid-template-columns:repeat(3,1fr)}}.story{padding:0}.story img{width:100%;aspect-ratio:16/10;object-fit:cover}.body{padding:14px}.body p{color:var(--muted);font-size:14px}.ad{background:white;border:1px solid var(--line);margin:20px 0;padding:12px;text-align:center;min-height:90px;color:#999;font-size:10px;letter-spacing:1px}.footer{background:#121212;color:#ccc;padding:28px;text-align:center}.footer a{color:white}.hidden{display:none!important}.article{max-width:720px;margin:auto;background:white;padding:24px}.article h1{font:700 30px var(--serif)}.article a{display:inline-block;background:var(--accent);color:white;padding:12px 22px;text-decoration:none;border-radius:5px}
</style></head><body>
<header class="mast"><h1>SSEGU <span>News</span> Updates</h1><p>CNN · BBC · Top stories</p></header>
<main class="wrap"><section id="home"><div class="ad">ADVERTISEMENT</div><input id="search" class="search" type="search" placeholder="Search stories…" autocomplete="off"><div id="filters" class="filters"></div><p id="status" class="status">Loading stories…</p><div id="lead"></div><div class="ad">ADVERTISEMENT</div><h2 class="section">Latest stories</h2><div id="stories" class="grid"></div></section><section id="article" class="article hidden"><button id="back">← Back to stories</button><div id="article-content"></div><div class="ad">ADVERTISEMENT</div></section></main>
<footer class="footer">SSEGU News Updates · Full articles remain with their publishers · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/contact/">Contact</a></footer>
<script is:inline>
(function(){var feeds=[['CNN','https://rss.cnn.com/rss/edition.rss'],['CNN','https://rss.cnn.com/rss/edition_world.rss'],['BBC','https://feeds.bbci.co.uk/news/rss.xml'],['BBC','https://feeds.bbci.co.uk/news/world/rss.xml']],items=[],filter='All';function el(id){return document.getElementById(id)}function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function plain(s){var d=document.createElement('div');d.innerHTML=s||'';return d.textContent||''}function img(i){return i.thumbnail||(i.enclosure&&i.enclosure.link)||((i.content||'').match(/<img[^>]+src=["']([^"']+)/i)||[])[1]||''}function open(x){el('home').classList.add('hidden');el('article').classList.remove('hidden');el('article-content').innerHTML='<div class="kicker">'+esc(x.source)+'</div><h1>'+esc(x.title)+'</h1><p>'+esc(x.date)+'</p><p>'+esc(x.description)+'</p><p>This summary is provided for convenience. The full story is available from its publisher.</p><a href="'+esc(x.link)+'" target="_blank" rel="noopener noreferrer">Continue to '+esc(x.source)+' →</a>';window.scrollTo(0,0)}function render(){var q=el('search').value.toLowerCase(),list=items.filter(function(x){return(filter==='All'||x.source===filter)&&(x.title+' '+x.description).toLowerCase().indexOf(q)>-1});el('status').textContent=list.length+' stories';el('filters').innerHTML=['All','CNN','BBC'].map(function(x){return '<button class="'+(filter===x?'active':'')+'" data-filter="'+x+'">'+x+'</button>'}).join('');el('filters').querySelectorAll('button').forEach(function(b){b.onclick=function(){filter=b.dataset.filter;render()}});if(!list.length){el('lead').innerHTML='';el('stories').innerHTML='<p>No stories found. Visit <a href="https://www.bbc.com/news">BBC</a> or <a href="https://edition.cnn.com/">CNN</a>.</p>';return}var x=list[0];el('lead').innerHTML='<div class="lead"><a class="hero" href="'+esc(x.link)+'" target="_blank" rel="noopener">'+(x.image?'<img src="'+esc(x.image)+'" alt="">':'')+'<div><span class="kicker">'+esc(x.source)+'</span><h2>'+esc(x.title)+'</h2><p>'+esc(x.description)+'</p></div></a><div class="side">'+list.slice(1,4).map(function(y){return '<article><span class="kicker">'+esc(y.source)+'</span><h3>'+esc(y.title)+'</h3><a href="'+esc(y.link)+'" target="_blank" rel="noopener">Read story →</a></article>'}).join('')+'</div></div>';el('stories').innerHTML=list.slice(4).map(function(y){return '<article class="story">'+(y.image?'<img loading="lazy" src="'+esc(y.image)+'" alt="">':'')+'<div class="body"><span class="kicker">'+esc(y.source)+'</span><h3>'+esc(y.title)+'</h3><p>'+esc(y.description)+'</p><small>'+esc(y.date)+' · <a href="'+esc(y.link)+'" target="_blank" rel="noopener">Read →</a></small></div></article>'}).join('')}Promise.all(feeds.map(function(f){return fetch('https://api.rss2json.com/v1/api.json?rss_url='+encodeURIComponent(f[1])).then(function(r){return r.json()}).then(function(d){return(d.items||[]).map(function(i){return{source:f[0],title:i.title||'Untitled',link:i.link||'#',description:plain(i.description||i.content).slice(0,240),image:img(i),date:i.pubDate||''}})}).catch(function(){return[]})})).then(function(groups){var seen={};items=groups.flat().filter(function(x){var k=x.title.toLowerCase();if(seen[k])return false;seen[k]=1;return true});render();el('status').textContent=items.length+' stories · refreshed '+new Date().toLocaleTimeString()});el('search').addEventListener('input',render);el('back').onclick=function(){el('article').classList.add('hidden');el('home').classList.remove('hidden');window.scrollTo(0,0)}})();
</script></body></html>