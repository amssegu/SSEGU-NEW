---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Page not found | SSEGU"
  description="The requested SSEGU page could not be found."
  noindex
>
  <div class="shell prose-page not-found">
    <p class="eyebrow">404</p>
    <h1>That page is not here</h1>
    <p>The link may be out of date, or the story has not been published in this fixture build.</p>
    <a class="button" href="/">
      Return to SSEGU home
    </a>
  </div>
</MainLayout>
