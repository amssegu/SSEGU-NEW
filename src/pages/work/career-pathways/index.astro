---
import WorkLayout from '../../../layouts/WorkLayout.astro';
import { getCollection } from 'astro:content';
import WorkArticleSidebar from '../../../components/work/WorkArticleSidebar.astro';
import { getPublishedWorkArticles } from '../../../lib/work';
const pathways = (await getCollection('pathways')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const recommendedArticles = (await getPublishedWorkArticles('career-advice')).slice(0, 2);
---
<WorkLayout title="Career pathways | SSEGU Work" description="Explore staged learning routes for career areas, with practical projects and course options.">
  <main class="work-page-shell">
    <p class="work-eyebrow">Learn toward a goal</p><h1>Career pathways</h1>
    <p>These twelve staged routes are research drafts. Course sequencing and local job evidence are still under review; no course alone guarantees employment or professional eligibility.</p>
    <div class="work-resource-layout">
      <div class="work-resource-grid">
        {pathways.map(({ data }) => <article class="work-resource-card" id={data.slug}><h2><a href={`/work/career-pathways/${data.slug}/`}>{data.title}</a></h2><p>{data.intendedLearner}</p><p>Draft pathway · local employer requirements and course references need review.</p></article>)}
      </div>
      <aside class="work-home-articles-aside" aria-label="Learning and career recommendations">
        <WorkArticleSidebar articles={recommendedArticles} />
      </aside>
    </div>
  </main>
</WorkLayout>

<style>
  .work-resource-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 320px);
    align-items: start;
    gap: 1.25rem;
  }
  .work-resource-layout > .work-resource-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 900px) {
    .work-resource-layout { grid-template-columns: minmax(0, 1fr); }
    .work-resource-layout > .work-resource-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .work-resource-layout > .work-resource-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
