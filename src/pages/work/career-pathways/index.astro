---
import WorkLayout from '../../../layouts/WorkLayout.astro';
import { getCollection } from 'astro:content';
const pathways = (await getCollection('pathways')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<WorkLayout title="Career pathways | SSEGU Work" description="Explore staged learning routes for career areas, with practical projects and course options.">
  <main class="work-page-shell">
    <p class="work-eyebrow">Learn toward a goal</p><h1>Career pathways</h1>
    <p>These twelve staged routes are research drafts. Course sequencing and local job evidence are still under review; no course alone guarantees employment or professional eligibility.</p>
    <div class="work-resource-grid">
      {pathways.map(({ data }) => <article class="work-resource-card" id={data.slug}><h2><a href={`/work/career-pathways/${data.slug}/`}>{data.title}</a></h2><p>{data.intendedLearner}</p><p>Draft pathway · local employer requirements and course references need review.</p></article>)}
    </div>
  </main>
</WorkLayout>
