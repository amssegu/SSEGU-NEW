---
import WorkLayout from '../../../layouts/WorkLayout.astro';
import WorkAside from '../../../components/work/WorkAside.astro';
import { formatWorkDate, internships } from '../../../lib/work';

export function getStaticPaths() {
  return internships.map((internship) => ({
    params: { slug: internship.slug },
    props: { internship },
  }));
}
const { internship } = Astro.props;
---

<WorkLayout
  title={`${internship.title} | SSEGU Work`}
  description={`${internship.title} at ${internship.employer}.`}
>
  <div class="work-page-shell work-detail-shell">
    <nav class="work-breadcrumbs" aria-label="Breadcrumb">
      <a href="/work/">Work</a>
      <span>/</span>
      <a href="/work/internships/">Internships</a>
      <span>/</span>
      <span aria-current="page">{internship.title}</span>
    </nav>
    <div class="work-detail-layout">
      <div class="work-detail-main">
        <article class="work-detail-card">
          <p class="work-eyebrow">Internship opportunity</p>
          <h1>{internship.title}</h1>
          <p class="work-detail-employer">{internship.employer}</p>
          <div class="work-detail-meta">
            <span>
              <strong>Location</strong>
              {internship.location}
            </span>
            <span>
              <strong>Arrangement</strong>
              {internship.arrangement}
            </span>
            <span>
              <strong>Deadline</strong>
              {formatWorkDate(internship.deadline)}
            </span>
          </div>
          <div class="work-detail-body">
            <h2>About this placement</h2>
            <p>{internship.description}</p>
            <p>
              This fixture page demonstrates the approved route boundary. Candidate applications and
              data collection are deferred.
            </p>
          </div>
          <div class="work-detail-actions">
            <button class="work-button" type="button" disabled>
              Application details coming later
            </button>
            <a class="work-button work-button-secondary" href="/work/internships/">
              Back to internships
            </a>
          </div>
        </article>
      </div>
      <WorkAside />
    </div>
  </div>
</WorkLayout>
