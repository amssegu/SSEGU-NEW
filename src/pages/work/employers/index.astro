---
import WorkLayout from '../../../layouts/WorkLayout.astro';
---

<WorkLayout
  title="Employers | SSEGU Work"
  description="Information for employers exploring SSEGU Work."
>
  <div class="work-page-shell work-employer-page">
    <div class="work-page-intro">
      <p class="work-eyebrow">Reach people ready to grow</p>
      <h1>Employers</h1>
      <p>
        SSEGU Work is designed to connect credible opportunities with people building their careers
        in Uganda.
      </p>
    </div>
    <div class="work-employer-grid">
      <section class="work-detail-card">
        <span class="work-resource-icon" aria-hidden="true">
          ♢
        </span>
        <h2>Share a clear opportunity</h2>
        <p>
          Give candidates the role, employer, location, arrangement and deadline details they need
          to make an informed decision.
        </p>
      </section>
      <section class="work-detail-card">
        <span class="work-resource-icon" aria-hidden="true">
          ♟
        </span>
        <h2>Support a stronger workforce</h2>
        <p>
          Practical jobs, internships, skills and career advice help people prepare for meaningful
          work.
        </p>
      </section>
    </div>
    <div class="work-employer-cta">
      <h2>Ready to talk to the team?</h2>
      <p>Send a vacancy for private editorial review. Publication is manual and never automatic.</p>
      <a class="work-button" href="/work/submit-job/">
        Submit a job
      </a>
    </div>
  </div>
</WorkLayout>
