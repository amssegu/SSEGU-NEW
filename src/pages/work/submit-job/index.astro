---
import WorkLayout from '../../../layouts/WorkLayout.astro';
---

<WorkLayout
  title="Submit a Job | SSEGU Work"
  description="Learn about the future SSEGU Work employer submission process."
  noindex
>
  <div class="work-page-shell work-detail-shell">
    <div class="work-detail-card">
      <p class="work-eyebrow">Employer information</p>
      <h1>Submit a Job</h1>
      <p class="work-lede">
        The employer submission workflow is planned for a later approved phase.
      </p>
      <div class="work-detail-body">
        <h2>What happens next</h2>
        <p>
          Phase 4 provides the fixture frontend only. No external form, account, database, file
          upload or automatic publication is connected here.
        </p>
        <p>
          When the submission workflow is approved, vacancies will enter a private review queue and
          will be manually verified before publication.
        </p>
      </div>
      <a class="work-button work-button-secondary" href="/work/employers/">
        Back to employers
      </a>
    </div>
  </div>
</WorkLayout>
