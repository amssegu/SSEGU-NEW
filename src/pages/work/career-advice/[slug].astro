---
import WorkLayout from '../../../layouts/WorkLayout.astro';
import { formatWorkDate, fromWorkEntry, workArticles } from '../../../lib/work';
import { absoluteUrl, articleJsonLd, breadcrumbJsonLd } from '../../../lib/seo';
import {
  estimateReadingTime,
  normalizeArticleBody,
  stripLegacyArticleLead,
} from '../../../lib/content';
import { selectRecommendations } from '../../../lib/recommendations';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = (await getCollection('work-articles')).filter(
    ({ data }) => data.status === 'published',
  );
  const contentSlugs = new Set(entries.map((entry) => entry.data.slug));
  const contentArticles = entries.map(fromWorkEntry);
  const allArticles = [
    ...contentArticles,
    ...workArticles.filter((article) => !contentSlugs.has(article.slug)),
  ];
  const relatedFor = (article: (typeof workArticles)[number]) =>
    selectRecommendations(
      allArticles.filter((item) => item.slug !== article.slug),
      article.slug,
      2,
    );
  return [
    ...workArticles
      .filter((article) => !contentSlugs.has(article.slug))
      .map((article) => ({
        params: { slug: article.slug },
        props: { article, related: relatedFor(article) },
      })),
    ...entries.map((entry, index) => ({
      params: { slug: entry.data.slug },
      props: {
        entry,
        article: contentArticles[index],
        related: relatedFor(contentArticles[index]),
      },
    })),
  ];
}
const { article: fixtureArticle, entry } = Astro.props as {
  article?: (typeof workArticles)[number];
  related?: (typeof workArticles)[number][];
  entry?: CollectionEntry<'work-articles'>;
};
const article = fixtureArticle ?? fromWorkEntry(entry!);
const relatedArticles = Astro.props.related ?? [];
const { Content } = entry ? await render(entry) : { Content: undefined };
const rawBody = entry?.body ?? '';
const cleanedBody = entry
  ? normalizeArticleBody(stripLegacyArticleLead(rawBody) ?? rawBody)
  : undefined;
const hasNormalizedBody = Boolean(entry && cleanedBody !== rawBody);
const readingTime = estimateReadingTime(rawBody || article.description);
const structuredData = [
  breadcrumbJsonLd([
    { name: 'Work', path: '/work/' },
    { name: 'Career Advice', path: '/work/career-advice/' },
    { name: article.title },
  ]),
  articleJsonLd({
    headline: article.title,
    description: article.description,
    image: article.image,
    datePublished: article.publishedAt,
    author: article.author,
    path: `/work/career-advice/${article.slug}/`,
    section: article.category,
  }),
];
---

<WorkLayout
  title={`${article.title} | SSEGU Work`}
  description={article.description}
  canonical={absoluteUrl(`/work/career-advice/${article.slug}/`)}
  image={article.image}
  type="article"
  publishedAt={article.publishedAt}
  updatedAt={article.updatedAt}
  author={article.author}
  section={article.category}
  structuredData={structuredData}
>
  <div class="work-page-shell work-detail-shell">
    <nav class="work-breadcrumbs" aria-label="Breadcrumb">
      <a href="/work/">Work</a>
      <span>/</span>
      <a href="/work/career-advice/">Career Advice</a>
      <span>/</span>
      <span aria-current="page">{article.title}</span>
    </nav>
    <article class="work-article-detail">
      <p class="work-eyebrow">{article.category}</p>
      <h1>{article.title}</h1>
      <p class="work-article-meta">
        By {article.author} · {formatWorkDate(article.publishedAt)} · {readingTime} min read
        {article.updatedAt && article.updatedAt !== article.publishedAt && (
          <> · Updated {formatWorkDate(article.updatedAt)}</>
        )}
      </p>
      <p class="work-article-dek">{article.description}</p>
      {article.tags.length > 0 && (
        <ul class="work-article-tags" aria-label="Article tags">
          {article.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
      <img
        src={article.image}
        alt={article.imageAlt ?? `Illustration for ${article.title}`}
        width="1200"
        height="675"
        loading="eager"
        decoding="async"
      />
      <div class="work-detail-body">
        {hasNormalizedBody ? (
          <div set:html={cleanedBody} />
        ) : Content ? (
          <Content />
        ) : (
          <>
            <p>{article.description}</p>
            <p>
              This fixture article is part of the Phase 4 frontend review. It demonstrates the Work
              editorial reading experience while authoritative content and CMS workflows remain
              deferred.
            </p>
            <h2>Make your next step clearer</h2>
            <p>
              Review the opportunity, identify the evidence that supports your strengths and prepare
              questions that show how you would contribute. Small, specific improvements make a
              strong application easier to understand.
            </p>
          </>
        )}
      </div>
    </article>
    {relatedArticles.length > 0 && (
      <section class="work-related" aria-labelledby="related-advice-title">
        <h2 id="related-advice-title">More career advice</h2>
        <div class="work-article-grid">
          {relatedArticles.map((item) => (
            <a class="work-related-link" href={`/work/career-advice/${item.slug}/`}>
              <img
                src={item.image}
                alt=""
                loading="lazy"
                decoding="async"
                width="320"
                height="180"
              />
              <span>
                <strong>{item.title}</strong>
                <small>{item.description}</small>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</WorkLayout>
