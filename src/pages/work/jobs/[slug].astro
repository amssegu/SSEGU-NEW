---
import WorkLayout from '../../../layouts/WorkLayout.astro';
import WorkAside from '../../../components/work/WorkAside.astro';
import WorkJobCard from '../../../components/work/WorkJobCard.astro';
import WorkJobSource from '../../../components/work/WorkJobSource.astro';
import {
  formatWorkDate,
  getWorkJobStatus,
  getPublishedWorkJobs,
  isEligibleWorkJob,
  jobPostingJsonLd,
  workJobStatusLabel,
} from '../../../lib/work';
import { absoluteUrl, breadcrumbJsonLd } from '../../../lib/seo';

export async function getStaticPaths() {
  return (await getPublishedWorkJobs({ status: 'all' })).map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

const { job } = Astro.props;
const allJobs = await getPublishedWorkJobs({ status: 'all' });
const relatedJobs = allJobs
  .filter((item) => item.slug !== job.slug && item.status === 'active')
  .slice(0, 2);
const eligible = isEligibleWorkJob(job);
const displayStatus = getWorkJobStatus(job);
const qualifications = job.qualifications ?? [];
const requirements = job.requirements ?? [];
const structuredData = [
  breadcrumbJsonLd([
    { name: 'Work', path: '/work/' },
    { name: 'Jobs', path: '/work/jobs/' },
    { name: job.title },
  ]),
  ...(eligible && jobPostingJsonLd(job) ? [jobPostingJsonLd(job)!] : []),
];
---

<WorkLayout
  title={`${job.title} | SSEGU Work`}
  description={`${job.title} at ${job.employer}.`}
  canonical={absoluteUrl(`/work/jobs/${job.slug}/`)}
  noindex={!eligible}
  structuredData={structuredData}
>
  <div class="work-page-shell work-detail-shell">
    <nav class="work-breadcrumbs" aria-label="Breadcrumb">
      <a href="/work/">Work</a>
      <span aria-hidden="true">/</span>
      <a href="/work/jobs/">Jobs</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{job.title}</span>
    </nav>
    <div class="work-detail-layout">
      <div class="work-detail-main">
        <article class="work-detail-card">
          <div class="work-detail-heading">
            <div>
              <p class="work-eyebrow">{job.category}</p>
              <h1>{job.title}</h1>
              <p class="work-detail-employer">{job.employer}</p>
            </div>
            <span class:list={['work-status-badge work-status-large', !eligible && 'is-expired']}>
              {eligible ? 'Active opportunity' : `${workJobStatusLabel(displayStatus)} opportunity`}
            </span>
          </div>
          <div class="work-detail-meta">
            <span>
              <strong>Location</strong>
              {job.location}
            </span>
            {job.country && (
              <span>
                <strong>Country</strong>
                {job.country}
              </span>
            )}
            <span>
              <strong>Work arrangement</strong>
              {job.arrangement}
            </span>
            <span>
              <strong>Employment type</strong>
              {job.employmentType}
            </span>
            <span>
              <strong>Deadline</strong>
              {formatWorkDate(job.deadline)}
            </span>
            {job.publishedAt && (
              <span>
                <strong>Published</strong>
                {formatWorkDate(job.publishedAt)}
              </span>
            )}
            {job.salaryText && (
              <span>
                <strong>Salary</strong>
                {job.salaryText}
                {job.salaryCurrency && !job.salaryText.includes(job.salaryCurrency)
                  ? ` ${job.salaryCurrency}`
                  : ''}
                {job.salaryPeriod && job.salaryPeriod !== 'unknown'
                  ? ` / ${job.salaryPeriod}`
                  : ''}
              </span>
            )}
          </div>
          {job.description && (
            <div class="work-detail-body">
              <h2>About this opportunity</h2>
              <p>{job.description}</p>
            </div>
          )}
          {(qualifications.length > 0 || requirements.length > 0) && (
            <div class="work-detail-information">
              {qualifications.length > 0 && (
                <section>
                  <h2>Qualifications</h2>
                  <ul>
                    {qualifications.map((qualification) => (
                      <li>{qualification}</li>
                    ))}
                  </ul>
                </section>
              )}
              {requirements.length > 0 && (
                <section>
                  <h2>Requirements</h2>
                  <ul>
                    {requirements.map((requirement) => (
                      <li>{requirement}</li>
                    ))}
                  </ul>
                </section>
              )}
            </div>
          )}
          {job.applicationInstructions && (
            <div class="work-detail-body">
              <h2>How to apply</h2>
              <p>{job.applicationInstructions}</p>
            </div>
          )}
          <div class="work-detail-actions">
            {eligible && job.applicationUrl ? (
              <a
                class="work-button"
                href={job.applicationUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                Apply on source
              </a>
            ) : (
              <p class="work-detail-notice">
                {eligible
                  ? 'Application details are not available for this listing.'
                  : 'This listing is no longer accepting applications.'}
              </p>
            )}
            <WorkJobSource job={job} />
            <a class="work-button work-button-secondary" href="/work/jobs/">
              Back to jobs
            </a>
          </div>
        </article>
        {relatedJobs.length > 0 && (
          <section class="work-related" aria-labelledby="related-jobs-title">
            <h2 id="related-jobs-title">More opportunities</h2>
            <div class="work-job-list">
              {relatedJobs.map((relatedJob) => (
                <WorkJobCard job={relatedJob} compact />
              ))}
            </div>
          </section>
        )}
      </div>
      <WorkAside />
    </div>
  </div>
</WorkLayout>
