---
import WorkLayout from '../../../layouts/WorkLayout.astro';
import WorkJobCard from '../../../components/work/WorkJobCard.astro';
import AdSlot from '../../../components/main/AdSlot.astro';
import { getJobFilterOptions, getPublishedWorkJobs, toWorkJobClientData } from '../../../lib/work';

const allJobs = await getPublishedWorkJobs({ status: 'all' });
const activeJobs = await getPublishedWorkJobs();
const jobFilters = getJobFilterOptions(allJobs);
const clientJobs = allJobs.map(toWorkJobClientData);
const initialJobs = activeJobs.filter(
  (job) =>
    job.country?.toUpperCase() === 'UG' || /uganda/i.test(`${job.location} ${job.country ?? ''}`),
);
---

<WorkLayout
  title="Jobs | SSEGU Work"
  description="Browse current job opportunities from SSEGU Work and follow the original source to apply."
>
  <div class="work-page-shell work-jobs-shell">
    <div class="work-page-intro">
      <p class="work-eyebrow">Find your next opportunity</p>
      <h1>Jobs</h1>
      <p>
        Search current opportunities by keyword, location, employment type and work arrangement.
        Listings link to the original employer or job source.
      </p>
    </div>
    <div class="work-jobs-layout">
      <section class="work-jobs-main" aria-label="Search and job listings">
        <nav class="work-filter-presets" aria-label="Popular job searches">
          <span>Popular:</span>
          <a href="/work/jobs/?location=Uganda">Uganda</a>
          <a href="/work/jobs/?location=&arrangement=Remote">Remote</a>
        </nav>
        <form id="work-job-filters" class="work-filter-panel" data-testid="work-job-filters">
          <div class="work-filter-quick-row">
            <div class="work-job-keyword-filter">
              <label class="sr-only" for="job-keyword">Search jobs</label>
              <input id="job-keyword" name="q" type="search" placeholder="Job title, employer or skill" />
            </div>
            <button class="work-button" type="submit">Search jobs</button>
            <button
              class="work-button work-button-secondary work-filter-toggle"
              id="toggle-job-filters"
              type="button"
              aria-expanded="false"
              aria-controls="job-advanced-filters"
            >
              More filters <span aria-hidden="true">⌄</span>
            </button>
          </div>
          <div class="work-filter-advanced" id="job-advanced-filters" hidden>
            <div class="work-filter-grid">
              <div>
                <label for="job-location">Location</label>
                <select id="job-location" name="location">
                  <option value="">All locations</option>
                  <option value="Uganda">Uganda, including remote jobs open to Ugandan applicants</option>
                  {jobFilters.locations.filter((option) => option.toLowerCase() !== 'uganda').map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="job-type">Employment type</label>
                <select id="job-type" name="type">
                  <option value="">All types</option>
                  {jobFilters.employmentTypes.map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="job-arrangement">Work arrangement</label>
                <select id="job-arrangement" name="arrangement">
                  <option value="">All arrangements</option>
                  {jobFilters.arrangements.map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="job-status">Listing status</label>
                <select id="job-status" name="status">
                  <option value="active">Active opportunities</option>
                  <option value="all">All listings</option>
                  <option value="expired">Expired opportunities</option>
                </select>
              </div>
            </div>
            <div class="work-filter-actions">
              <button class="work-button work-button-secondary" id="clear-job-filters" type="button">
                Reset filters
              </button>
              <label class="work-sort-control" for="job-sort">
                <span>Sort results</span>
                <select id="job-sort" name="sort">
                  <option value="relevance">Relevance</option>
                  <option value="newest">Newest</option>
                  <option value="deadline">Deadline soonest</option>
                </select>
              </label>
            </div>
          </div>
        </form>
        <div id="job-active-filters" class="work-active-filters" aria-label="Active filters" hidden></div>
        <div class="work-job-results-heading">
          <div>
            <p class="work-eyebrow">Opportunities</p>
            <h2>Jobs for you</h2>
          </div>
          <p id="job-filter-status" class="work-results-status" role="status" aria-live="polite">
            Showing {initialJobs.length} active {initialJobs.length === 1 ? 'opportunity' : 'opportunities'} in Uganda
          </p>
        </div>
        <template id="job-inline-ad-template">
          <AdSlot placement="section" format="horizontal" minHeight={90} />
        </template>
        <div id="job-results" class="work-job-results" data-testid="work-job-results">
          {initialJobs.map((job) => (
            <WorkJobCard job={job} />
          ))}
        </div>
        <p id="job-empty-state" class="work-empty-state" hidden={initialJobs.length > 0}>
          {allJobs.length
            ? 'No Uganda-eligible opportunities are currently listed. Choose All locations to broaden your search.'
            : 'We’re connecting job sources. New opportunities will appear here as listing details are checked.'}
        </p>
        <nav class="work-pagination" id="job-pagination" aria-label="Job result pages" hidden>
          <button class="work-pagination-button" type="button" data-page-action="previous">Previous</button>
          <div class="work-pagination-pages" id="job-pagination-pages"></div>
          <button class="work-pagination-button" type="button" data-page-action="next">Next</button>
        </nav>
      </section>
      <aside class="work-jobs-aside" aria-label="Job search resources and advertisement">
        <AdSlot placement="sidebar" format="rectangle" minHeight={280} />
        <section class="work-jobs-aside-panel">
          <p class="work-eyebrow">Search with confidence</p>
          <h2>Before you apply</h2>
          <p>Review the original listing for the latest requirements, closing date and application steps.</p>
          <ul>
            <li>Applications go to the employer or original job source.</li>
            <li>Check that the role is still open before sharing personal details.</li>
            <li>SSEGU Work does not charge applicants to apply.</li>
          </ul>
          <a href="/work/submit-job/">Employers: submit a job <span aria-hidden="true">→</span></a>
        </section>
      </aside>
    </div>
  </div>
  <script define:vars={{ jobs: clientJobs }} is:inline>
    const form = document.querySelector('#work-job-filters');
    const results = document.querySelector('#job-results');
    const status = document.querySelector('#job-filter-status');
    const emptyState = document.querySelector('#job-empty-state');
    const keyword = document.querySelector('#job-keyword');
    const location = document.querySelector('#job-location');
    const type = document.querySelector('#job-type');
    const arrangement = document.querySelector('#job-arrangement');
    const listingStatus = document.querySelector('#job-status');
    const sort = document.querySelector('#job-sort');
    const clearButton = document.querySelector('#clear-job-filters');
    const filterToggle = document.querySelector('#toggle-job-filters');
    const activeFilters = document.querySelector('#job-active-filters');
    const advancedFilters = document.querySelector('#job-advanced-filters');
    const pagination = document.querySelector('#job-pagination');
    const paginationPages = document.querySelector('#job-pagination-pages');
    const inlineAdTemplate = document.querySelector('#job-inline-ad-template');
    const pageSize = 10;
    const dateFormatter = new Intl.DateTimeFormat('en-UG', { dateStyle: 'medium' });
    const params = new URLSearchParams(window.location.search);
    let currentPage = Math.max(1, Number.parseInt(params.get('page') || '1', 10) || 1);
    keyword.value = params.get('q') || '';
    location.value = params.has('location') ? params.get('location') || '' : 'Uganda';
    type.value = params.get('type') || '';
    arrangement.value = params.get('arrangement') || '';
    listingStatus.value = params.get('status') || 'active';
    sort.value = params.get('sort') || 'relevance';
    if (
      (params.has('location') && location.value !== 'Uganda') ||
      type.value ||
      arrangement.value ||
      listingStatus.value !== 'active' ||
      sort.value !== 'relevance'
    ) {
      advancedFilters.hidden = false;
      filterToggle.setAttribute('aria-expanded', 'true');
      filterToggle.innerHTML = 'Fewer filters <span aria-hidden="true">⌃</span>';
    }

    const escapeHtml = (value) =>
      String(value).replace(
        /[&<>'"]/g,
        (character) =>
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            "'": '&#39;',
            '"': '&quot;',
          })[character],
      );
    const renderJob = (job) => `
        <article class="work-job-card${job.status !== 'active' ? ' is-expired' : ''}">
        <div class="work-job-icon" aria-hidden="true">▣</div>
        <div class="work-job-content">
          <div class="work-job-heading"><div>
            <p class="work-card-kicker">${escapeHtml(job.category)}</p>
            <h3><a href="/work/jobs/${escapeHtml(job.slug)}/">${escapeHtml(job.title)}</a></h3>
            <p class="work-job-employer">${escapeHtml(job.employer)}</p>
          </div><span class="work-status-badge${job.status !== 'active' ? ' is-expired' : ''}">${job.status === 'active' ? 'Active' : job.status[0].toUpperCase() + job.status.slice(1)}</span></div>
          ${job.description ? `<p class="work-job-description">${escapeHtml(job.description)}</p>` : ''}
        <div class="work-job-meta"><span>⌖ ${escapeHtml(job.location)}${job.country ? `, ${escapeHtml(job.country)}` : ''}</span><span>Employment: ${escapeHtml(job.employmentType)}</span><span>▣ ${escapeHtml(job.arrangement)}</span>${job.publishedAt ? `<span>Posted: ${dateFormatter.format(new Date(job.publishedAt))}</span>` : ''}<span>Deadline: ${job.deadline ? dateFormatter.format(new Date(`${job.deadline}T12:00:00Z`)) : 'No deadline listed'}</span>${job.salaryText ? `<span>Salary: ${escapeHtml(job.salaryText)}${job.salaryCurrency && !job.salaryText.includes(job.salaryCurrency) ? ` ${escapeHtml(job.salaryCurrency)}` : ''}${job.salaryPeriod && job.salaryPeriod !== 'unknown' ? ` / ${escapeHtml(job.salaryPeriod)}` : ''}</span>` : ''}</div>
        ${job.sourceUrl || (job.status === 'active' && job.applicationUrl) ? `<div class="work-job-source">${job.sourceUrl ? `<span>Source: <a href="${escapeHtml(job.sourceUrl)}" rel="noopener noreferrer" target="_blank">${escapeHtml(job.sourceAttribution || 'Original listing')}</a></span>` : ''}${job.status === 'active' && job.applicationUrl ? `<a class="work-button work-button-small" href="${escapeHtml(job.applicationUrl)}" rel="noopener noreferrer" target="_blank">Apply on source</a>` : ''}</div>` : ''}
        <a class="work-job-card-cta" href="/work/jobs/${escapeHtml(job.slug)}/">View full job details <span aria-hidden="true">→</span></a>
        </div>
        <a class="work-job-arrow" href="/work/jobs/${escapeHtml(job.slug)}/" aria-label="View ${escapeHtml(job.title)}"><span aria-hidden="true">→</span></a>
      </article>`;
    const applyFilters = (updateUrl = true, resetPage = true) => {
      if (resetPage) currentPage = 1;
      const query = keyword.value.trim().toLowerCase();
      const selectedStatus = listingStatus.value;
      const matches = jobs.filter((job) => {
        const haystack = [job.title, job.employer, job.category, job.description]
          .join(' ')
          .toLowerCase();
        const matchesLocation =
          !location.value ||
          (location.value === 'Uganda'
            ? job.country.toUpperCase() === 'UG' || /uganda/i.test(`${job.location} ${job.country}`)
            : job.location === location.value);
        return (
          (!query || haystack.includes(query)) &&
          matchesLocation &&
          (!type.value || job.employmentType === type.value) &&
          (!arrangement.value || job.arrangement === arrangement.value) &&
          (selectedStatus === 'all' || job.status === selectedStatus)
        );
      });
      if (sort.value === 'newest') {
        matches.sort((a, b) => (b.publishedAt || '').localeCompare(a.publishedAt || ''));
      } else if (sort.value === 'deadline') {
        matches.sort((a, b) => {
          if (!a.deadline) return 1;
          if (!b.deadline) return -1;
          return a.deadline.localeCompare(b.deadline);
        });
      }
      const pageCount = Math.ceil(matches.length / pageSize);
      currentPage = Math.min(currentPage, Math.max(pageCount, 1));
      const startIndex = (currentPage - 1) * pageSize;
      const pageJobs = matches.slice(startIndex, startIndex + pageSize);
      let adsOnPage = 0;
      results.innerHTML = pageJobs
        .map((job, index) => {
          let markup = renderJob(job);
          if ((index + 1) % 3 === 0 && adsOnPage < 5 && inlineAdTemplate) {
            adsOnPage += 1;
            markup += inlineAdTemplate.innerHTML;
          }
          return markup;
        })
        .join('');
      if (document.querySelector('script[data-ssegu-adsense]')) {
        results.querySelectorAll('.adsbygoogle:not([data-ad-requested])').forEach((ad) => {
          ad.setAttribute('data-ad-requested', '1');
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (error) {
            ad.removeAttribute('data-ad-requested');
            console.warn('AdSense could not load this job-listing ad slot.', error);
          }
        });
      }
      emptyState.hidden = matches.length !== 0;
      emptyState.innerHTML = jobs.length
        ? 'No opportunities match those filters. Try removing a filter or broadening your search. <a href="/work/jobs/">Clear filters</a>'
        : 'We’re connecting job sources. New opportunities will appear here as listing details are checked.';
      status.textContent = matches.length
        ? `Showing ${startIndex + 1}–${Math.min(startIndex + pageSize, matches.length)} of ${matches.length} ${matches.length === 1 ? 'opportunity' : 'opportunities'}.`
        : '0 opportunities shown.';
      const chips = [
        query ? ['q', `Search: ${keyword.value.trim()}`] : null,
        location.value ? ['location', `Location: ${location.value}`] : null,
        type.value ? ['type', `Type: ${type.value}`] : null,
        arrangement.value ? ['arrangement', `Work mode: ${arrangement.value}`] : null,
        selectedStatus !== 'active' ? ['status', `Status: ${selectedStatus}`] : null,
      ].filter(Boolean);
      activeFilters.hidden = chips.length === 0;
      activeFilters.innerHTML = chips
        .map(([key, label]) => `<button type="button" class="work-filter-chip" data-filter="${key}" aria-label="Remove ${escapeHtml(label)} filter">${escapeHtml(label)} <span aria-hidden="true">×</span></button>`)
        .join('');
      pagination.hidden = pageCount <= 1;
      pagination.querySelector('[data-page-action="previous"]').disabled = currentPage <= 1;
      pagination.querySelector('[data-page-action="next"]').disabled = currentPage >= pageCount;
      const visiblePages = pageCount ? new Set([1, pageCount]) : new Set();
      for (let page = Math.max(1, currentPage - 1); page <= Math.min(pageCount, currentPage + 1); page += 1) {
        visiblePages.add(page);
      }
      let previousPage = 0;
      paginationPages.innerHTML = [...visiblePages]
        .sort((a, b) => a - b)
        .map((page) => {
          const gap = page - previousPage > 1 ? '<span class="work-pagination-ellipsis" aria-hidden="true">…</span>' : '';
          previousPage = page;
          return `${gap}<button class="work-pagination-button${page === currentPage ? ' is-current' : ''}" type="button" data-page="${page}"${page === currentPage ? ' aria-current="page"' : ''}>${page}</button>`;
        })
        .join('');
      if (updateUrl) {
        const next = new URLSearchParams();
        if (keyword.value.trim()) next.set('q', keyword.value.trim());
        next.set('location', location.value);
        if (type.value) next.set('type', type.value);
        if (arrangement.value) next.set('arrangement', arrangement.value);
        if (listingStatus.value !== 'active') next.set('status', listingStatus.value);
        if (sort.value !== 'relevance') next.set('sort', sort.value);
        if (currentPage > 1) next.set('page', String(currentPage));
        const queryString = next.toString();
        history.replaceState(
          null,
          '',
          `${window.location.pathname}${queryString ? `?${queryString}` : ''}`,
        );
      }
    };
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters();
    });
    filterToggle?.addEventListener('click', () => {
      const expanded = filterToggle.getAttribute('aria-expanded') === 'true';
      filterToggle.setAttribute('aria-expanded', String(!expanded));
      advancedFilters.hidden = expanded;
      filterToggle.innerHTML = expanded
        ? 'More filters <span aria-hidden="true">⌄</span>'
        : 'Fewer filters <span aria-hidden="true">⌃</span>';
    });
    activeFilters?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-filter]');
      if (!button) return;
      const inputs = { q: keyword, location, type, arrangement, status: listingStatus };
      const input = inputs[button.dataset.filter];
      if (!input) return;
      input.value = button.dataset.filter === 'status' ? 'active' : '';
      applyFilters();
    });
    pagination?.addEventListener('click', (event) => {
      const button = event.target.closest('button');
      if (!button || button.disabled) return;
      if (button.dataset.page) currentPage = Number(button.dataset.page);
      else if (button.dataset.pageAction === 'previous') currentPage -= 1;
      else if (button.dataset.pageAction === 'next') currentPage += 1;
      else return;
      applyFilters(true, false);
    });
    clearButton?.addEventListener('click', () => {
      form.reset();
      location.value = 'Uganda';
      listingStatus.value = 'active';
      applyFilters();
      keyword.focus();
    });
    sort?.addEventListener('change', () => applyFilters());
    [keyword].forEach((input) => input?.addEventListener('input', () => applyFilters()));
    [location, type, arrangement, listingStatus].forEach((input) =>
      input?.addEventListener('change', () => applyFilters()),
    );
    applyFilters(false);
  </script>
</WorkLayout>
