---
import WorkCourseCatalog from '../../../components/work/WorkCourseCatalog.astro';
import { getCourseFilterOptions, getPublishedWorkCourses } from '../../../lib/work';

const pageSize = 48;
const allCourses = await getPublishedWorkCourses();
const pageCount = Math.max(1, Math.ceil(allCourses.length / pageSize));
---

<WorkCourseCatalog
  courses={allCourses.slice(0, pageSize)}
  allCourses={allCourses}
  options={getCourseFilterOptions(allCourses)}
  page={1}
  pageCount={pageCount}
  total={allCourses.length}
/>
