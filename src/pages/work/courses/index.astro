---
import WorkLayout from '../../../layouts/WorkLayout.astro';
import { workCourses } from '../../../lib/work';
---

<WorkLayout
  title="Courses | SSEGU Work"
  description="Browse fixture courses and skills resources from SSEGU Work."
>
  <div class="work-page-shell">
    <div class="work-page-intro">
      <p class="work-eyebrow">Build useful skills</p>
      <h1>Courses</h1>
      <p>Explore fixture learning paths that support confident work and career growth.</p>
    </div>
    <div class="work-resource-grid">
      {workCourses.map((course) => (
        <article class="work-resource-card">
          <span class="work-resource-icon" aria-hidden="true">
            ◆
          </span>
          <p class="work-card-kicker">{course.format}</p>
          <h2>
            <a href={`/work/courses/${course.slug}/`}>{course.title}</a>
          </h2>
          <p class="work-resource-provider">{course.provider}</p>
          <p>{course.description}</p>
          <a class="work-text-link" href={`/work/courses/${course.slug}/`}>
            View course →
          </a>
        </article>
      ))}
    </div>
  </div>
</WorkLayout>
