---
import WorkLayout from '../../../layouts/WorkLayout.astro';
import WorkCourseCard from '../../../components/work/WorkCourseCard.astro';
import WorkArticleSidebar from '../../../components/work/WorkArticleSidebar.astro';
import { getCourseDirectory, getPublishedWorkArticles } from '../../../lib/work';
const courses = (await getCourseDirectory()).filter((course) => ['free', 'free_course', 'free learning'].includes((course.coursePriceStatus ?? '').toLowerCase()));
const recommendedArticles = (await getPublishedWorkArticles('career-advice')).slice(0, 2);
---
<WorkLayout title="Free courses | SSEGU Work" description="Courses with free learning access, with access and credential terms shown separately.">
  <main class="work-page-shell">
    <p class="work-eyebrow">Free-first learning</p><h1>Free courses</h1>
    <p>“Free” refers to learning access, not necessarily a certificate or exam. These course profiles are approved for publication, but current provider terms and regional availability can still require checking. Confirm the conditions with the provider before enrolling.</p>
    <div class="work-resource-layout">
      <div class="work-resource-grid">
        {courses.length ? courses.map((course) => <WorkCourseCard course={course} />) : <p>No course currently has a confirmed fully free learning-access model. Courses with free previews or conditional audit access are not counted as fully free.</p>}
      </div>
      <aside class="work-home-articles-aside" aria-label="Learning and career recommendations">
        <WorkArticleSidebar articles={recommendedArticles} />
      </aside>
    </div>
  </main>
</WorkLayout>

<style>
  .work-resource-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 320px);
    align-items: start;
    gap: 1.25rem;
  }
  .work-resource-layout > .work-resource-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 900px) {
    .work-resource-layout { grid-template-columns: minmax(0, 1fr); }
    .work-resource-layout > .work-resource-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .work-resource-layout > .work-resource-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
