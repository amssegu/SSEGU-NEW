---
import WorkCourseCatalog from '../../../../components/work/WorkCourseCatalog.astro';
import { getCourseFilterOptions, getCourseDirectory } from '../../../../lib/work';

export async function getStaticPaths() {
  const pageSize = 9;
  const allCourses = await getCourseDirectory();
  const pageCount = Math.ceil(allCourses.length / pageSize);
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: {
        courses: allCourses.slice((page - 1) * pageSize, page * pageSize),
        allCourses,
        options: getCourseFilterOptions(allCourses),
        page,
        pageCount,
        total: allCourses.length,
      },
    };
  });
}

const { courses, allCourses, options, page, pageCount, total } = Astro.props;
---

<WorkCourseCatalog
  courses={courses}
  allCourses={allCourses}
  options={options}
  page={page}
  pageCount={pageCount}
  total={total}
/>
