---
import WorkLayout from '../../../../layouts/WorkLayout.astro';
import CvChecklistTool from '../../../../components/work/CvChecklistTool.astro';
---

<WorkLayout
  title="CV Final-Check List | SSEGU Work"
  description="Check your CV details, evidence, formatting and application instructions before applying."
  canonical="https://ssegu.com/work/cv-resources/checklist/"
>
  <main class="work-page-shell">
    <nav class="work-breadcrumbs" aria-label="Breadcrumb">
      <a href="/work/">Work</a><span>/</span><a href="/work/cv-resources/">CV Resources</a><span>/</span><span aria-current="page">CV Checklist</span>
    </nav>
    <div class="work-page-intro">
      <p class="work-eyebrow">Free application tool</p>
      <h1 id="checklist-title">CV final-check list</h1>
      <p>A few careful checks can help you catch errors before your CV reaches an employer.</p>
    </div>
    <CvChecklistTool />
    <p class="cv-tool-back"><a href="/work/cv-resources/">← Back to CV resources</a></p>
  </main>
</WorkLayout>

<style>
  .cv-tool-back { margin-top: 1.5rem; font-weight: 700; }
</style>
