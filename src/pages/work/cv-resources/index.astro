---
import WorkLayout from '../../../layouts/WorkLayout.astro';
import CvBuilder from '../../../components/work/CvBuilder.astro';
import CvApplicationTools from '../../../components/work/CvApplicationTools.astro';
import { formatWorkDate, getPublishedWorkArticles } from '../../../lib/work';
const recommendedSlugs = [
  'how-to-write-cv-in-uganda-that-gets',
  'how-to-tailor-your-cv-for-different',
  '12-common-cv-mistakes-that-could-cost',
  'how-to-write-winning-cv-your-ultimate',
];
const recommendedArticles = (await getPublishedWorkArticles('career-advice'))
  .filter((article) => recommendedSlugs.includes(article.slug))
  .sort((a, b) => recommendedSlugs.indexOf(a.slug) - recommendedSlugs.indexOf(b.slug));
---

<WorkLayout
  title="CV Resources | SSEGU Work"
  description="Create a clear, ATS-readable CV and find practical CV, cover letter and interview advice from SSEGU Work."
>
  <div class="work-page-shell">
    <div class="work-page-intro">
      <p class="work-eyebrow">Make your next application count</p>
      <h1>CV Resources and Free CV Builder</h1>
      <p>
        Build a CV that is easy for applicant tracking systems to read and easy for a person to scan.
        Start with the free builder, then use the guides below to improve each part of your application.
      </p>
    </div>
    <CvBuilder />
    <section class="cv-recommendations" aria-labelledby="cv-guides-title">
      <div class="work-page-intro">
        <p class="work-eyebrow">Read while you build</p>
        <h2 id="cv-guides-title">CV advice from SSEGU</h2>
        <p>Open a guide alongside the builder for practical examples on CV writing, tailoring and reviewing.</p>
      </div>
      <div class="work-article-grid cv-article-grid">
        {recommendedArticles.map((article) => (
          <article class="work-advice-card">
            <a href={`/work/career-advice/${article.slug}/`}>
              <img src={article.image} alt={article.imageAlt ?? ''} width="1200" height="675" loading="lazy" />
              <div>
                <p class="work-card-kicker">{article.category}</p>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
                <small>By {article.author} · {formatWorkDate(article.publishedAt)}</small>
                <span class="cv-article-link">Read this guide →</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
    <CvApplicationTools />
  </div>
</WorkLayout>

<style>
  .cv-recommendations { margin: 2.5rem 0; scroll-margin-top: 1rem; }
  .cv-article-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cv-article-grid h3 { margin: .4rem 0; color: var(--work-navy-deep); font-size: 1.2rem; }
  .cv-article-grid > article { transition: transform 160ms ease, box-shadow 160ms ease; }
  .cv-article-grid > article:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgb(22 59 124 / 13%); }
  .cv-article-link { display: inline-block; margin-top: .5rem; color: var(--work-blue); font-weight: 800; }
  @media (max-width: 640px) { .cv-article-grid { grid-template-columns: 1fr; } }
</style>
