---
import WorkLayout from '../../../layouts/WorkLayout.astro';
import WorkAside from '../../../components/work/WorkAside.astro';
import { cvResources } from '../../../lib/work';
export function getStaticPaths() {
  return cvResources.map((resource) => ({ params: { slug: resource.slug }, props: { resource } }));
}
const { resource } = Astro.props;
---

<WorkLayout title={`${resource.title} | SSEGU Work`} description={resource.description}>
  <div class="work-page-shell work-detail-shell">
    <nav class="work-breadcrumbs" aria-label="Breadcrumb">
      <a href="/work/">Work</a>
      <span>/</span>
      <a href="/work/cv-resources/">CV Resources</a>
      <span>/</span>
      <span aria-current="page">{resource.title}</span>
    </nav>
    <div class="work-detail-layout">
      <div class="work-detail-main">
        <article class="work-detail-card">
          <p class="work-eyebrow">CV resource</p>
          <h1>{resource.title}</h1>
          <div class="work-detail-body">
            <p>{resource.detail}</p>
            <p>
              Keep every claim accurate and relevant to the opportunity. For more detailed CV
              guidance, visit the <a href="/work/cv-resources/">free CV builder and resource library</a>.
            </p>
          </div>
          <a class="work-button work-button-secondary" href="/work/cv-resources/">
            Back to CV resources
          </a>
        </article>
      </div>
      <WorkAside />
    </div>
  </div>
</WorkLayout>
