# Public/non-secret configuration names only.
# Production secrets belong in the Cloudflare Dashboard.
PUBLIC_SITE_URL=https://ssegu.pages.dev
# Optional: point the Live TV cards at a deployed channel catalog/player.
PUBLIC_LIVE_TV_URL=https://www.ssegu.com/tv/
# Only set this when the player host explicitly permits iframe embedding.
PUBLIC_LIVE_TV_EMBED_URL=
# Public Turnstile site key for /work/submit-job/. The matching secret belongs
# in the Cloudflare Pages secret store as TURNSTILE_SECRET_KEY.
PUBLIC_TURNSTILE_SITE_KEY=
# Non-secret hostname checked against the Turnstile verification response.
TURNSTILE_EXPECTED_HOSTNAME=ssegu.com
# AdSense is intentionally disabled until traffic and placement are reviewed.
# Keep these IDs documented, but do not uncomment them without enabling ads deliberately.
# PUBLIC_ADSENSE_ENABLED=false
# PUBLIC_ADSENSE_CLIENT=ca-pub-7777536386845474
# PUBLIC_ADSENSE_SLOT=9970802556
