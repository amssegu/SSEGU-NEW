{
  "name": "ssegu-main-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run export:work",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write src scripts astro.config.mjs",
    "format:check": "prettier --check src scripts astro.config.mjs",
    "lint": "prettier --check src scripts astro.config.mjs",
    "test": "node scripts/test.mjs",
    "test:migration": "bash scripts/test-work-aggregation-migration.sh",
    "test:aggregation": "node --experimental-strip-types scripts/test-aggregation.mjs",
    "export:work": "node scripts/export-work-data.mjs",
    "test:work-export": "node scripts/test-work-export.mjs",
    "test:security": "node --experimental-strip-types scripts/phase9-security-test.mjs",
    "test:e2e": "node scripts/smoke-test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "review:phase9": "node scripts/phase9-review.mjs",
    "migrate:phase7": "node scripts/phase7-migration.mjs",
    "migrate:phase8": "node scripts/phase8-migration.mjs",
    "promote:phase8": "node scripts/promote-phase8.mjs",
    "validate:redirects": "node scripts/validate-phase8-redirects.mjs",
    "generate:redirects": "node scripts/generate-phase8-redirects.mjs",
    "migrate:media": "node scripts/migrate-phase8-media.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "astro": "7.4.1",
    "hls.js": "^1.5.7",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tailwindcss": "4.3.5",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
