# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# In production at ssegu.com, set to https://ssegu.com
APP_URL="https://ssegu.com"

# BLOGGER_SOURCE_URL: Upstream Blogger source for movie posts and pages.
BLOGGER_SOURCE_URL="https://vj.ssegu.com"

# BASE_PATH: Subdirectory path where Ssegu Movies (Firimu) is mounted.
BASE_PATH="/firimu"

# PORT: Server port (AI Studio requires 3000 in development).
PORT="3000"
